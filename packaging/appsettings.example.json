// Pine configuration: an example. Every setting Pine reads, each at its default.
//
// Pine runs with no configuration file at all, and that is the normal case. To change something,
// copy this file to Pine's data directory as `appsettings.json`:
//
//   Windows  %LOCALAPPDATA%\Pine\appsettings.json
//   macOS    ~/Library/Application Support/Pine/appsettings.json
//
// then delete every line you are not changing. A key you leave out keeps its default.
//
// Pine REFUSES TO START on a key it does not recognise, and says which one, because a misspelled key
// used to be ignored silently (TD-117). It refuses a value outside its bounds the same way, listing
// every problem at once. The same settings can be given as environment variables:
// PINE_Pine__Ai__CategorisationConfidenceThreshold=0.5
//
// Restart Pine after editing; the file is read once, at startup.
{
  "Pine": {
    "Storage": {
      // Absolute path. The default is the per-user data directory above; this example leaves it
      // unset because the right value differs on every machine.
      // "DataDirectory": "D:\\PineData",
      "VaultsDirectoryName": "Vaults",
      "LogsDirectoryName": "logs"
    },
    "Security": {
      // Argon2id cost for vaults CREATED from now on. An existing vault keeps the parameters in its
      // own header; changing these never touches it. Lowering them weakens every new vault.
      "NewVaultKdfMemoryKib": 65536,
      "NewVaultKdfIterations": 3,
      "NewVaultKdfParallelism": 4,
      // Automatic backups kept per vault. At least 1.
      "BackupsToKeep": 5,
      // Idle time before an open vault locks itself. Between 00:01:00 and 08:00:00.
      "AutoLockIdleTimeout": "00:10:00"
    },
    "Ai": {
      // Between 0 and 1. A suggested category below this confidence is discarded.
      "CategorisationConfidenceThreshold": 0.3,
      "MinimumTrainingRows": 10,
      "TrainingBatchThreshold": 10,
      "TrainingStartupDelay": "00:01:00",
      "TrainingInterval": "00:05:00"
      // Optional LayoutLMv3 receipt model, off until you supply it (CC BY-NC-SA 4.0, research use; never bundled).
      // Absolute paths. The tokenizer defaults to tokenizer.json beside the model.
      // "LayoutLmModelPath": "D:/Models/model_int8.onnx",
      // "LayoutLmTokenizerPath": "D:/Models/tokenizer.json"
    },
    "Ui": {
      "TransactionsPageSize": 30,
      "DiagnosticsLogEntryLimit": 200
    }
  }
}
