<Project>

  <!--
    CENTRAL PACKAGE MANAGEMENT (TD-42).

    WHAT WAS WRONG. Every version in this repository was written in the .csproj that used it, so a
    package used by two projects carried two independent literals and nothing compared them. The
    audit recorded the symptom in §5: `Microsoft.EntityFrameworkCore.Sqlite.Core 10.0.9` against
    `Microsoft.EntityFrameworkCore.Design 10.0.11`. Those two packages share `Relational` and
    `Abstractions`, so NuGet unified them silently — the build was green, the versions on disk were
    not the versions in the files, and no reader of either .csproj could see it.

    WHAT THIS FILE IS. `ManagePackageVersionsCentrally` moves every version to this one file:
    a `.csproj` names a package, this file names its version, and a `Version` attribute in a
    `.csproj` becomes a build ERROR (NU1008) rather than a second opinion. `BuildHygieneTests`
    enforces the rest — every reference resolves here, nothing here is unreferenced, and the
    EF Core family holds one version — because CPM by itself permits a `Directory.Packages.props`
    that has drifted just as far as the .csproj files did.

    WHAT IT DELIBERATELY DOES NOT DO. It does not add `CentralPackageTransitivePinning`. Pinning
    transitive versions here would silence the one signal this repository still has for a
    dependency it does not name — NU1605 on a downgrade — and it would freeze a graph nothing
    currently audits. That is a separate decision, and it should be taken with evidence.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    UI: Avalonia and its heads. One version for the whole framework, by construction.

    `Avalonia.Browser` was pinned here until iteration 31, when the Browser head was deleted
    (Phase 3, item 1). Central package management is what makes that removal safe to see: the pin
    had exactly one consumer, so with the consumer gone the pin has none. It goes too, rather than
    sitting here inviting a second Browser head into existence.
  -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Android" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Headless" Version="12.0.5" />
    <PackageVersion Include="Avalonia.iOS" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Skia" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="FluentAvaloniaUI" Version="3.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.1" />
  </ItemGroup>

  <!--
    DATA. EF Core is the family TD-42 named: `Sqlite.Core` sat at 10.0.9 while `Design` sat at
    10.0.11, and both pull `Relational`. They are one version now, and `BuildHygieneTests` fails
    the build if they diverge again.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.11" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <!-- Application plumbing. -->
  <ItemGroup>
    <PackageVersion Include="MediatR" Version="14.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <!-- Security. -->
  <ItemGroup>
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <!-- Import and document parsing. -->
  <ItemGroup>
    <PackageVersion Include="CsvHelper" Version="33.0.1" />
    <PackageVersion Include="ExcelDataReader" Version="3.7.0" />
    <PackageVersion Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageVersion Include="PdfPig" Version="0.1.9" />
  </ItemGroup>

  <!--
    AI AND VISION.

    `Sdcb.PaddleOCR.Models.Local` is the FACADE — 36 MB, the `LocalFullModels` type the OCR engine
    names — and `Sdcb.PaddleOCR.Models.LocalV5` is where the weights it hands out actually live.
    Its own .nuspec declares `Sdcb.PaddleOCR.Models.LocalV5 >= 3.0.0` as a dependency, so it is in
    the graph whether or not this file names it; it is named explicitly to hold it at 3.3.1
    alongside the facade instead of floating down to the 3.0.0 floor.

    TD-41 said "keep one". Two is the minimum the graph permits, and that is the correction. What
    was genuinely removable was `Models.LocalV3` (238 MB) and `Models.LocalV4` (234 MB): neither
    defines `LocalFullModels`, neither is a dependency of anything referenced here, and no file in
    `src/` or `tests/` names either one.

    `Microsoft.ML.OnnxRuntime` stays, as iteration 27 established: `ReceiptDetector` runs real
    inference over `yolo-receipt-nano.onnx`.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.ML" Version="5.0.0" />
    <PackageVersion Include="Microsoft.ML.FastTree" Version="5.0.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageVersion Include="Sdcb.PaddleInference" Version="3.3.1" />
    <PackageVersion Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
    <PackageVersion Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageVersion Include="Sdcb.PaddleOCR.Models.Local" Version="3.3.1" />
    <PackageVersion Include="Sdcb.PaddleOCR.Models.LocalV5" Version="3.3.1" />
  </ItemGroup>

  <!-- Test-only. -->
  <ItemGroup>
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
