<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CA1707: xunit test names are Method_Should_Behaviour, which the rule dislikes.
         CA1848/CA1873: the LoggerMessage-delegate rules. They are ERRORS in the product
         assemblies and stay that way; a test that drives the sink is exercising the ILogger
         extension surface on purpose, and rewriting each of those calls as a generated
         delegate would test the generator instead of the sink. -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Headless Skia platform: ScanReceiptViewModel.ProcessReceiptImageAsync decodes the picked
         image into an Avalonia Bitmap before anything else, which needs a registered
         IPlatformRenderInterface. Pine.Ui.Avalonia itself never configures one, only the OS heads
         (Pine.Ui.Windows, Pine.Ui.Macos) do, via Avalonia.Desktop, so a plain xunit host throws
         "Unable to locate 'Avalonia.Platform.IPlatformRenderInterface'" the moment a test reaches
         that line. TestAppInitializer registers a headless Skia platform once per test run. -->
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pine.Core\Pine.Core.csproj" />
    <ProjectReference Include="..\..\src\Pine.Application\Pine.Application.csproj" />
    <ProjectReference Include="..\..\src\Pine.Infrastructure\Pine.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Pine.Ui.Avalonia\Pine.Ui.Avalonia.csproj" />
  </ItemGroup>

</Project>