<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="Pine.Ui.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Default accent palette. Swapped at runtime by ThemeManager. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Pine.Ui.Avalonia/Themes/AmberTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light Mode: neutral base. Accent tokens come from the active palette (Themes/*.axaml). -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PineBackground" Color="#FCFBF9" />
                    <SolidColorBrush x:Key="PineSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PineSurfaceHover" Color="#FFF8F2" />
                    <SolidColorBrush x:Key="PineText" Color="#2D231E" />
                    <SolidColorBrush x:Key="PineTextMuted" Color="#827168" />
                    <SolidColorBrush x:Key="PineBorder" Color="#EAE4DF" />
                    <SolidColorBrush x:Key="PineButtonText" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PineSidebar" Color="#F5F0EB" />
                    <SolidColorBrush x:Key="PineSidebarBorder" Color="#E5DDD6" />
                    <SolidColorBrush x:Key="PineDanger" Color="#DC3545" />
                    <SolidColorBrush x:Key="PineDangerHover" Color="#C82333" />
                    <SolidColorBrush x:Key="PineError" Color="#DC3545" />
                    <SolidColorBrush x:Key="PineDangerContainer" Color="#FDECEC" />
                    <SolidColorBrush x:Key="PineWarning" Color="#E8940C" />
                    <SolidColorBrush x:Key="PineSuccess" Color="#2E9E5B" />
                    <SolidColorBrush x:Key="PineSurfaceElevated" Color="#F7F2EC" />
                    <SolidColorBrush x:Key="PineScrim" Color="#66000000" />

                    <!-- FluentAvalonia Overrides — harmonize with warm tones -->
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FCFBF9" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF8F2" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFF5EB" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#E5DDD6" />
                    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#EAE4DF" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#2D231E" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6B5D53" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#9A8B80" />
                </ResourceDictionary>
                
                <!-- Dark Mode: neutral base. Accent tokens come from the active palette (Themes/*.axaml). -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PineBackground" Color="#0F0B09" />
                    <SolidColorBrush x:Key="PineSurface" Color="#1A1412" />
                    <SolidColorBrush x:Key="PineSurfaceHover" Color="#241C18" />
                    <SolidColorBrush x:Key="PineText" Color="#F5F0EB" />
                    <SolidColorBrush x:Key="PineTextMuted" Color="#9A8B80" />
                    <SolidColorBrush x:Key="PineBorder" Color="#2E241E" />
                    <SolidColorBrush x:Key="PineButtonText" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PineSidebar" Color="#161110" />
                    <SolidColorBrush x:Key="PineSidebarBorder" Color="#2E241E" />
                    <SolidColorBrush x:Key="PineDanger" Color="#E54B5A" />
                    <SolidColorBrush x:Key="PineDangerHover" Color="#D43A49" />
                    <SolidColorBrush x:Key="PineError" Color="#E54B5A" />
                    <SolidColorBrush x:Key="PineDangerContainer" Color="#3A1C1F" />
                    <SolidColorBrush x:Key="PineWarning" Color="#F5A623" />
                    <SolidColorBrush x:Key="PineSuccess" Color="#7ED321" />
                    <SolidColorBrush x:Key="PineSurfaceElevated" Color="#241C18" />
                    <SolidColorBrush x:Key="PineScrim" Color="#99000000" />

                    <!-- FluentAvalonia Overrides — harmonize with warm umber tones -->
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0F0B09" />
                    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1A1412" />
                    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#201915" />
                    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#241C18" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2E241E" />
                    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#3A2E26" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F5F0EB" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A3948B" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7A6D64" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme CustomAccentColor="#F57104" PreferUserAccentColor="False" />
        <StyleInclude Source="avares://Pine.Ui.Avalonia/Controls/ImageCropperControl.axaml" />
        <StyleInclude Source="avares://Pine.Ui.Avalonia/Controls/ImageLightbox.axaml" />
        
        <!-- ═══ Global Button: "pine-accent" class ═══ -->
        <Style Selector="Button.pine-accent">
            <Setter Property="Background" Value="{DynamicResource PineAccentGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource PineButtonText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pine-accent:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="Button.pine-accent:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!-- ═══ Global Button: "pine-danger" class ═══ -->
        <Style Selector="Button.pine-danger">
            <Setter Property="Background" Value="{DynamicResource PineDanger}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pine-danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource PineDangerHover}" />
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="Button.pine-danger:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        
        <!-- ═══ Sidebar Navigation Buttons ═══ -->
        <Style Selector="Button.pine-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PineTextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pine-nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource PineSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource PineText}" />
        </Style>
        <Style Selector="Button.pine-nav.active">
            <Setter Property="Background" Value="{DynamicResource PineAccentGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource PineButtonText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ═══ Touch devices (class "touch" is set on the shell by ShellView on Android/iOS) ═══
             Targets of at least 44 dp, body text of at least 16, more air between rows. Desktop never gets the class. -->
        <Style Selector="SplitView.touch Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="SplitView.touch Button.pine-nav">
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <Style Selector="SplitView.touch TextBox, SplitView.touch ComboBox, SplitView.touch NumericUpDown, SplitView.touch DatePicker">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="SplitView.touch ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ═══ Bottom tab bar buttons: "pine-tab" ═══ -->
        <Style Selector="Button.pine-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PineTextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="SplitView.touch Button.pine-tab">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style Selector="Button.pine-tab.active">
            <Setter Property="Background" Value="{DynamicResource PineAccentGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource PineButtonText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ═══ Password strength meter bands (TD-11) ═══
             Applied to both the meter's ProgressBar (whose indicator template-binds to Foreground)
             and its status TextBlock, so the pass/fail state is never colour-only: the same class
             also selects wording built in SetupViewModel. Reuses the existing danger/warning/success
             vocabulary from BudgetsView/ScanReceiptView rather than inventing a fourth palette. -->
        <Style Selector="ProgressBar.pine-strength-danger">
            <Setter Property="Foreground" Value="{DynamicResource PineDanger}" />
        </Style>
        <Style Selector="TextBlock.pine-strength-danger">
            <Setter Property="Foreground" Value="{DynamicResource PineDanger}" />
        </Style>
        <Style Selector="ProgressBar.pine-strength-warning">
            <Setter Property="Foreground" Value="{DynamicResource PineWarning}" />
        </Style>
        <Style Selector="TextBlock.pine-strength-warning">
            <Setter Property="Foreground" Value="{DynamicResource PineWarning}" />
        </Style>
        <Style Selector="ProgressBar.pine-strength-success">
            <Setter Property="Foreground" Value="{DynamicResource PineSuccess}" />
        </Style>
        <Style Selector="TextBlock.pine-strength-success">
            <Setter Property="Foreground" Value="{DynamicResource PineSuccess}" />
        </Style>

        <!-- ═══ Smooth Transitions for Cards ═══ -->
        <Style Selector="Border.card">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
            <Setter Property="Background" Value="{DynamicResource PineSurfaceHover}" />
        </Style>

        <!-- ═══ Secondary / Outline Button: "pine-outline" class ═══ -->
        <Style Selector="Button.pine-outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PineText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PineBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pine-outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PineSurfaceHover}" />
        </Style>
        <Style Selector="Button.pine-outline:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
            <Setter Property="BorderBrush" Value="{DynamicResource PinePrimary}" />
        </Style>
        <Style Selector="Button.pine-outline:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>

        <!-- ═══ Input focus feedback ═══ -->
        <Style Selector="TextBox, NumericUpDown, ComboBox, DatePicker">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <!-- ═══ Reusable entrance: fade + rise. Apply Classes="reveal" ═══ -->
        <Style Selector=":is(Control).reveal">
            <Style.Animations>
                <Animation Duration="0:0:0.35" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
