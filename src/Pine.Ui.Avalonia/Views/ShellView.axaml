<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Pine.Ui.Avalonia.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <Grid ColumnDefinitions="240, *" Background="{DynamicResource PineBackground}">
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource PineSidebar}"
                BorderBrush="{DynamicResource PineSidebarBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Title at Top -->
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,0">
                    <TextBlock Text="Pine Vault" FontSize="22" FontWeight="Bold" 
                               Foreground="{DynamicResource PineText}" />
                    <TextBlock Text="Secure Finance" FontSize="12" 
                               Foreground="{DynamicResource PineTextMuted}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Manual lock (TD-11): the only pre-existing ways to lock were an idle timeout
                     and a failed unlock attempt; there was no deliberate "I'm stepping away"
                     action. Docked to the bottom, outside the scrolling nav list, so it stays
                     reachable regardless of how many nav items are added above it. Must be added
                     to the DockPanel BEFORE the ScrollViewer: DockPanel's default
                     LastChildFill="True" makes whichever child is added LAST the one that fills
                     the remaining space, regardless of its own Dock value. -->
                <Button DockPanel.Dock="Bottom" Content="Lock Vault" Command="{Binding LockVaultCommand}"
                        Classes="pine-nav" Margin="16,8,16,20"
                        Foreground="{DynamicResource PineDanger}" />

                <!-- Navigation Buttons -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="4" Margin="16,28,16,16">
                        <Button Content="Dashboard" Command="{Binding NavigateToDashboardCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsDashboardActive}" />
                        <Button Content="Transactions" Command="{Binding NavigateToTransactionsCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsTransactionsActive}" />
                        <Button Content="Scan Receipt" Command="{Binding NavigateToScanReceiptCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsScanReceiptActive}" />
                        <Button Content="Live Scanner" Command="{Binding NavigateToLiveScannerCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsLiveScannerActive}" />
                        <Button Content="Budgets" Command="{Binding NavigateToBudgetsCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsBudgetsActive}" />
                        <Button Content="Rules" Classes="pine-nav" IsEnabled="False" Opacity="0.5" ToolTip.Tip="Coming soon" />

                        <Border Height="1" Background="{DynamicResource PineBorder}" Margin="4,12" />

                        <Button Content="Settings" Command="{Binding NavigateToSettingsCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsSettingsActive}" />
                        <Button Content="Diagnostics" Command="{Binding NavigateToDiagnosticsCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsDiagnosticsActive}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentPage}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.2" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </Grid>
</UserControl>
