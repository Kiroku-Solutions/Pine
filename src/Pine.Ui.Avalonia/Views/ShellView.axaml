<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Pine.Ui.Avalonia.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <SplitView x:Name="NavSplit" DisplayMode="Inline" OpenPaneLength="240"
               IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
               PanePlacement="Left" Background="{DynamicResource PineBackground}"
               PaneBackground="{DynamicResource PineSidebar}">
      <SplitView.Pane>
        <!-- Sidebar Navigation -->
        <Border Background="{DynamicResource PineSidebar}"
                BorderBrush="{DynamicResource PineSidebarBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Title at Top -->
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,0">
                    <TextBlock Text="{loc:Tr Shell.Brand.Title}" FontSize="22" FontWeight="Bold" 
                               Foreground="{DynamicResource PineText}" />
                    <TextBlock Text="{loc:Tr Shell.Brand.Subtitle}" FontSize="12" 
                               Foreground="{DynamicResource PineTextMuted}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Manual lock (TD-11): the only pre-existing ways to lock were an idle timeout
                     and a failed unlock attempt; there was no deliberate "I'm stepping away"
                     action. Docked to the bottom, outside the scrolling nav list, so it stays
                     reachable regardless of how many nav items are added above it. Must be added
                     to the DockPanel BEFORE the ScrollViewer: DockPanel's default
                     LastChildFill="True" makes whichever child is added LAST the one that fills
                     the remaining space, regardless of its own Dock value. -->
                <Button DockPanel.Dock="Bottom" Content="{loc:Tr Shell.LockVault}" Command="{Binding LockVaultCommand}"
                        Classes="pine-nav" Margin="16,8,16,20"
                        Foreground="{DynamicResource PineDanger}" />

                <!-- Navigation Buttons -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="4" Margin="16,28,16,16">
                        <Button Content="{loc:Tr Shell.Nav.Dashboard}" Command="{Binding NavigateToDashboardCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsDashboardActive}" />
                        <Button Content="{loc:Tr Shell.Nav.Transactions}" Command="{Binding NavigateToTransactionsCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsTransactionsActive}" />
                        <!-- TD-85: these two are the only pages whose backing pipeline does not
                             exist on every head, so they are the only two that are gated. IsVisible
                             rather than IsEnabled, and rather than the "Coming soon" treatment the
                             Rules button gets below. Rules is unbuilt everywhere and will arrive;
                             receipt scanning is built and simply cannot run on this platform, and a
                             permanently greyed button is a worse answer than no button. The binding
                             source is the same PineHeadCapabilities object that decides whether
                             the factory will build ScanReceiptViewModel and LiveScannerViewModel at
                             all (TD-121 moved that check out of the container and into
                             PineViewModelFactory), so a visible button always has a view model
                             behind it. -->
                        <Button Content="{loc:Tr Shell.Nav.ScanReceipt}" Command="{Binding NavigateToScanReceiptCommand}"
                                IsVisible="{Binding HasReceiptScan}"
                                Classes="pine-nav" Classes.active="{Binding IsScanReceiptActive}" />
                        <Button Content="{loc:Tr Shell.Nav.LiveScan}" Command="{Binding NavigateToInlineLiveScanCommand}"
                                IsVisible="{Binding HasInlineLiveScan}"
                                Classes="pine-nav" />
                        <Button Content="{loc:Tr Shell.Nav.LiveScanner}" Command="{Binding NavigateToLiveScannerCommand}"
                                IsVisible="{Binding HasReceiptVision}"
                                Classes="pine-nav" Classes.active="{Binding IsLiveScannerActive}" />
                        <Button Content="{loc:Tr Shell.Nav.Budgets}" Command="{Binding NavigateToBudgetsCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsBudgetsActive}" />
                        <!-- Enabled as of the Phase 3 rule-engine work. It was disabled, dimmed and tagged
                             "Coming soon" while nothing evaluated a rule: honest, but a promise. -->
                        <Button Content="{loc:Tr Shell.Nav.Rules}" Command="{Binding NavigateToRulesCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsRulesActive}" />
                        <!-- Post-audit plan item 3.1c: what a merge left for a person to decide. -->
                        <Button Content="{loc:Tr Shell.Nav.SyncConflicts}" Command="{Binding NavigateToSyncConflictsCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsSyncConflictsActive}" />
                        <!-- Post-audit plan item 3.1e: giving a second vault the sync key, by hand. -->
                        <Button Content="{loc:Tr Shell.Nav.SyncPairing}" Command="{Binding NavigateToSyncPairingCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsSyncPairingActive}" />
                        <!-- Post-audit plan item 3.1f: one exchange with every paired copy, through a shared folder. -->
                        <Button Content="{loc:Tr Shell.Nav.SyncRun}" Command="{Binding NavigateToSyncRunCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsSyncRunActive}" />

                        <TextBlock Text="{loc:Tr Shell.Nav.ReceiptUnavailable}" IsVisible="{Binding ShowReceiptVisionNote}"
                                   TextWrapping="Wrap" FontSize="11" Margin="12,6,12,0"
                                   Foreground="{DynamicResource PineTextMuted}" />
                        <TextBlock Text="{loc:Tr Shell.Nav.LiveScanUnavailable}" IsVisible="{Binding ShowLiveScanNote}"
                                   TextWrapping="Wrap" FontSize="11" Margin="12,6,12,0"
                                   Foreground="{DynamicResource PineTextMuted}" />

                        <Border Height="1" Background="{DynamicResource PineBorder}" Margin="4,12" />

                        <Button Content="{loc:Tr Shell.Nav.Settings}" Command="{Binding NavigateToSettingsCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsSettingsActive}" />
                        <Button Content="{loc:Tr Shell.Nav.Diagnostics}" Command="{Binding NavigateToDiagnosticsCommand}"
                                Classes="pine-nav" Classes.active="{Binding IsDiagnosticsActive}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
      </SplitView.Pane>

      <SplitView.Content>
        <DockPanel>
            <!-- Menu bar, only when the sidebar is a drawer (narrow screens). -->
            <Border DockPanel.Dock="Top" IsVisible="{Binding ShowMenuBar}"
                    Background="{DynamicResource PineSidebar}" Padding="8">
                <Button Content="{loc:Tr Shell.Menu}" Command="{Binding TogglePaneCommand}"
                        Classes="pine-nav" HorizontalAlignment="Left" FontSize="18" />
            </Border>
            <!-- Bottom tab bar (narrow touch screens): the four things done most, then More, which opens the drawer. -->
            <Border DockPanel.Dock="Bottom" IsVisible="{Binding UseBottomNav}"
                    Background="{DynamicResource PineSidebar}"
                    BorderBrush="{DynamicResource PineSidebarBorder}" BorderThickness="0,1,0,0" Padding="4,4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                    <Button Content="{loc:Tr Shell.Nav.Dashboard}" Command="{Binding NavigateToDashboardCommand}"
                            Classes="pine-tab" Classes.active="{Binding IsDashboardActive}" />
                    <Button Content="{loc:Tr Shell.Nav.Transactions}" Command="{Binding NavigateToTransactionsCommand}"
                            Classes="pine-tab" Classes.active="{Binding IsTransactionsActive}" />
                    <Button Content="{loc:Tr Shell.Nav.ScanReceipt}" Command="{Binding NavigateToScanReceiptCommand}"
                            IsVisible="{Binding HasReceiptScan}"
                            Classes="pine-tab" Classes.active="{Binding IsScanReceiptActive}" />
                    <Button Content="{loc:Tr Shell.Nav.LiveScan}" Command="{Binding NavigateToInlineLiveScanCommand}"
                            IsVisible="{Binding HasInlineLiveScan}"
                            Classes="pine-tab" />
                    <Button Content="{loc:Tr Shell.Nav.More}" Command="{Binding TogglePaneCommand}"
                            Classes="pine-tab" />
                </StackPanel>
            </Border>
            <!-- Main Content Area -->
            <TransitioningContentControl Content="{Binding CurrentPage}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.2" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </DockPanel>
      </SplitView.Content>
    </SplitView>
</UserControl>
