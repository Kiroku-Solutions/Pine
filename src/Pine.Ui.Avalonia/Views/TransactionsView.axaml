<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:views="using:Pine.Ui.Avalonia.Views"
             xmlns:core="using:Pine.Core.Transactions"
             xmlns:conv="using:Pine.Ui.Avalonia.Utils"
             xmlns:controls="using:Pine.Ui.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Pine.Ui.Avalonia.Views.TransactionsView"
             x:DataType="vm:TransactionsViewModel">

    <UserControl.Styles>
        <!-- A voided transaction stays in the list. It is dimmed and struck through rather than
             hidden, because the record of a correction is the reason for voiding instead of
             deleting: a row that disappears cannot be audited. -->
        <Style Selector="Border.voided TextBlock">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Border.voided TextBlock.tx-primary">
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <Style Selector="Border.voided Border.tx-avatar">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Default & semantic transaction type styling (Light & Dark WCAG AA tokens) -->
        <Style Selector="Border.tx-avatar">
            <Setter Property="Background" Value="{DynamicResource PineSurface}" />
        </Style>
        <Style Selector="Path.tx-icon">
            <Setter Property="Stroke" Value="{DynamicResource PineText}" />
        </Style>
        <Style Selector="TextBlock.tx-amount">
            <Setter Property="Foreground" Value="{DynamicResource PineText}" />
        </Style>

        <Style Selector="Border.tx-income Border.tx-avatar">
            <Setter Property="Background" Value="{DynamicResource PineSuccessContainer}" />
        </Style>
        <Style Selector="Border.tx-income Path.tx-icon">
            <Setter Property="Stroke" Value="{DynamicResource PineSuccess}" />
        </Style>
        <Style Selector="Border.tx-income TextBlock.tx-amount">
            <Setter Property="Foreground" Value="{DynamicResource PineSuccess}" />
        </Style>

        <Style Selector="Border.tx-expense Border.tx-avatar">
            <Setter Property="Background" Value="{DynamicResource PineDangerContainer}" />
        </Style>
        <Style Selector="Border.tx-expense Path.tx-icon">
            <Setter Property="Stroke" Value="{DynamicResource PineDanger}" />
        </Style>
        <Style Selector="Border.tx-expense TextBlock.tx-amount">
            <Setter Property="Foreground" Value="{DynamicResource PineDanger}" />
        </Style>

        <Style Selector="Border.tx-transfer Border.tx-avatar">
            <Setter Property="Background" Value="{DynamicResource PineInfoContainer}" />
        </Style>
        <Style Selector="Border.tx-transfer Path.tx-icon">
            <Setter Property="Stroke" Value="{DynamicResource PineInfo}" />
        </Style>
        <Style Selector="Border.tx-transfer TextBlock.tx-amount">
            <Setter Property="Foreground" Value="{DynamicResource PineInfo}" />
        </Style>

        <Style Selector="Button.tx-filter-chip">
            <Setter Property="Background" Value="{DynamicResource PineSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource PineText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PineBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.tx-filter-chip.active">
            <Setter Property="Background" Value="{DynamicResource PinePrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource PineButtonText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PinePrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Root">
        <!-- Main Content Area -->
        <Grid x:Name="MainGrid" RowDefinitions="Auto, Auto, *" Margin="40">

            <!-- Header -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="HeaderTitle" Text="{loc:Tr Transactions.Header.Title}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Tr Transactions.Header.Subtitle}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- TD-71: voided rows are hidden by default; this brings them back. -->
                    <CheckBox x:Name="ShowVoidedCheckBox" Content="{loc:Tr Transactions.ShowVoided}" IsChecked="{Binding ShowVoided}" VerticalAlignment="Center" />
                    <Button x:Name="AddTransactionButton" Content="{loc:Tr Transactions.AddButton}" Command="{Binding ShowAddTransactionDialogCommand}" Classes="pine-accent" VerticalAlignment="Center" HorizontalContentAlignment="Center" MinHeight="44" Padding="16,10" CornerRadius="10" FontSize="14" />
                </StackPanel>
            </Grid>

            <!-- Search & Filter Bar -->
            <Border Grid.Row="1" Margin="0,0,0,14" Padding="14,12" CornerRadius="12"
                    Background="{DynamicResource PineSurface}"
                    BorderBrush="{DynamicResource PineBorder}"
                    BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid x:Name="FilterInputsGrid" ColumnDefinitions="*, 10, Auto">
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="{loc:Tr Transactions.Filter.SearchPlaceholder}"
                                 AutomationProperties.Name="{loc:Tr Transactions.Filter.SearchPlaceholder}"
                                 MinHeight="40" />
                        <ComboBox x:Name="AccountFilterBox"
                                  Grid.Column="2"
                                  ItemsSource="{Binding AccountFilterOptions}"
                                  SelectedItem="{Binding SelectedAccountFilter}"
                                  MinWidth="150" MaxWidth="220" MinHeight="40"
                                  AutomationProperties.Name="{loc:Tr Transactions.Filter.AccountLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TransactionAccountFilterOption">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="tx-filter-chip" Classes.active="{Binding IsAllTypeSelected}"
                                Content="{loc:Tr Transactions.Filter.TypeAll}"
                                Command="{Binding SelectTypeFilterCommand}" CommandParameter="0" />
                        <Button Classes="tx-filter-chip" Classes.active="{Binding IsExpenseTypeSelected}"
                                Content="{loc:Tr Transactions.Filter.TypeExpense}"
                                Command="{Binding SelectTypeFilterCommand}" CommandParameter="1" />
                        <Button Classes="tx-filter-chip" Classes.active="{Binding IsIncomeTypeSelected}"
                                Content="{loc:Tr Transactions.Filter.TypeIncome}"
                                Command="{Binding SelectTypeFilterCommand}" CommandParameter="2" />
                        <Button Classes="tx-filter-chip" Classes.active="{Binding IsTransferTypeSelected}"
                                Content="{loc:Tr Transactions.Filter.TypeTransfer}"
                                Command="{Binding SelectTypeFilterCommand}" CommandParameter="3" />
                        <Button Classes="pine-outline"
                                Content="{loc:Tr Transactions.Filter.Clear}"
                                Command="{Binding ClearFiltersCommand}"
                                IsVisible="{Binding HasActiveFilters}"
                                MinHeight="36" Padding="10,6" CornerRadius="16" FontSize="12" Margin="4,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Transactions List -->
            <Border x:Name="ListBorder" Grid.Row="2" Padding="20" CornerRadius="12"
                    Background="{DynamicResource PineSurface}"
                    BorderBrush="{DynamicResource PineBorder}"
                    BorderThickness="1"
                    BoxShadow="0 4 16 0 #18000000">

                <ScrollViewer>
                    <StackPanel>
                        <!-- TD-35: this page used to swallow every load failure, so an unreadable
                             vault looked exactly like an empty one. Shown only when there is
                             something to say. -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource PineError}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Empty State -->
                        <StackPanel IsVisible="{Binding ShowEmptyState}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="16,36" Spacing="8">
                            <TextBlock Text="{loc:Tr Transactions.EmptyState.Title}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PineText}"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="{loc:Tr Transactions.EmptyState.Hint}"
                                       FontSize="13"
                                       Foreground="{DynamicResource PineTextMuted}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="360" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Transactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="core:Transaction">
                                    <Border Classes="card"
                                            Classes.voided="{Binding IsVoided}"
                                            Classes.tx-income="{Binding Type, Converter={x:Static conv:Converters.IsIncomeTransaction}}"
                                            Classes.tx-expense="{Binding Type, Converter={x:Static conv:Converters.IsExpenseTransaction}}"
                                            Classes.tx-transfer="{Binding Type, Converter={x:Static conv:Converters.IsTransferTransaction}}"
                                            Background="{DynamicResource PineSurfaceElevated}"
                                            BorderBrush="{DynamicResource PineBorder}"
                                            BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                        <Grid RowDefinitions="Auto, Auto">
                                            <!-- Row 0: Semantic Icon Badge + Payee/Meta + Semantic Amount -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                                <Border Grid.Column="0" Classes="tx-avatar" Width="42" Height="42" CornerRadius="12"
                                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Path Classes="tx-icon" Width="20" Height="20" Stretch="Uniform"
                                                          StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                                                          Data="{Binding Type, Converter={x:Static conv:Converters.TransactionTypeIcon}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,10,0">
                                                    <WrapPanel>
                                                        <TextBlock Classes="tx-primary" Text="{Binding Payee}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource PineText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />

                                                        <!-- The badge carries the reason in its tooltip -->
                                                        <Border IsVisible="{Binding IsVoided}"
                                                                Background="{DynamicResource PineDangerContainer}"
                                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                ToolTip.Tip="{Binding VoidReason}">
                                                            <TextBlock Text="{loc:Tr Transactions.VoidedBadge}" FontSize="10" FontWeight="Bold" Opacity="1"
                                                                       Foreground="{DynamicResource PineDanger}" />
                                                        </Border>

                                                        <!-- Zero-amount import marker -->
                                                        <Border IsVisible="{Binding IsZeroAmountImport}"
                                                                Background="{DynamicResource PineSurface}"
                                                                BorderThickness="1" BorderBrush="{DynamicResource PineBorder}"
                                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                                ToolTip.Tip="{loc:Tr ImportReview.ImportedZeroAmount}">
                                                            <TextBlock Text="{loc:Tr ImportWizard.Legend.ZeroAmount}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{DynamicResource PineTextMuted}" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <!-- Date + Account Pill + Category Pill -->
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Date, Converter={x:Static conv:Converters.ProseDate}}"
                                                                   FontSize="12" Foreground="{DynamicResource PineTextMuted}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,2" />

                                                        <Border CornerRadius="6" Padding="6,2" Margin="0,0,6,2"
                                                                Background="{DynamicResource PineSurface}"
                                                                BorderBrush="{DynamicResource PineBorder}" BorderThickness="1">
                                                            <Border.IsVisible>
                                                                <MultiBinding Converter="{x:Static conv:Converters.HasAccountName}">
                                                                    <Binding Path="AccountId" />
                                                                    <Binding Path="#Root.((vm:TransactionsViewModel)DataContext).AccountNames" />
                                                                </MultiBinding>
                                                            </Border.IsVisible>
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource PineTextMuted}">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{x:Static conv:Converters.AccountNameLookup}">
                                                                        <Binding Path="AccountId" />
                                                                        <Binding Path="#Root.((vm:TransactionsViewModel)DataContext).AccountNames" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Border>

                                                        <Border CornerRadius="6" Padding="6,2" Margin="0,0,0,2"
                                                                Background="{DynamicResource PineInfoContainer}"
                                                                IsVisible="{Binding ., Converter={x:Static conv:Converters.HasTransactionPrimaryCategory}}">
                                                            <TextBlock Text="{Binding ., Converter={x:Static conv:Converters.TransactionPrimaryCategory}}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PineInfo}" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding Notes}" FontSize="12" Foreground="{DynamicResource PineTextMuted}" TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>

                                                <!-- Semantic Amount -->
                                                <TextBlock Grid.Column="2" Classes="tx-primary tx-amount"
                                                           Text="{Binding TotalAmount}" FontWeight="Bold" FontSize="15"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>

                                            <!-- Row 1: Wrapping action buttons — never collides on narrow phones -->
                                            <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                                                <!-- Receipt marker. Visible only when this transaction has
                                                     evidence attached; clicking it opens the image. The
                                                     marker is driven by a set of ids the page loads with
                                                     each page of transactions, so no receipt is read from
                                                     the database to draw it. -->
                                                <Button Classes="pine-outline"
                                                        Content="{loc:Tr Transactions.ViewReceipt}"
                                                        FontSize="12" MinHeight="36" Padding="10,6" Margin="0,0,8,6"
                                                        AutomationProperties.Name="{loc:Tr Transactions.ViewReceiptAutomationName}"
                                                        Command="{Binding #Root.((vm:TransactionsViewModel)DataContext).ViewReceiptCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static conv:Converters.IsInIdSet}">
                                                            <Binding Path="Id" />
                                                            <Binding Path="#Root.((vm:TransactionsViewModel)DataContext).TransactionsWithReceipts" />
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>

                                                <!-- Edit action (TD-68). Sits next to Void so a correction never has
                                                     to go through void-then-re-enter. Hidden exactly where the
                                                     command would refuse: voided, a transfer leg, or more than one
                                                     split (see Converters.CanEditTransaction). -->
                                                <Button Classes="pine-outline"
                                                        Content="{loc:Tr Transactions.EditAction}"
                                                        FontSize="12" MinHeight="36" Padding="10,6" Margin="0,0,8,6"
                                                        IsVisible="{Binding ., Converter={x:Static conv:Converters.CanEditTransaction}}"
                                                        AutomationProperties.Name="{loc:Tr Transactions.EditAutomationName}"
                                                        Command="{Binding #Root.((vm:TransactionsViewModel)DataContext).BeginEditCommand}"
                                                        CommandParameter="{Binding}" />

                                                <Button Classes="pine-outline"
                                                        Content="{loc:Tr Transactions.VoidAction}"
                                                        FontSize="12" MinHeight="36" Padding="10,6" Margin="0,0,8,6"
                                                        IsVisible="{Binding !IsVoided}"
                                                        AutomationProperties.Name="{loc:Tr Transactions.VoidAutomationName}"
                                                        Command="{Binding #Root.((vm:TransactionsViewModel)DataContext).BeginVoidCommand}"
                                                        CommandParameter="{Binding}" />

                                                <!-- Unvoid action (TD-69). Shares the Void slot: exactly one of the two
                                                     is ever visible. -->
                                                <Button Classes="pine-outline"
                                                        Content="{loc:Tr Transactions.UnvoidAction}"
                                                        FontSize="12" MinHeight="36" Padding="10,6" Margin="0,0,8,6"
                                                        IsVisible="{Binding IsVoided}"
                                                        AutomationProperties.Name="{loc:Tr Transactions.UnvoidAutomationName}"
                                                        Command="{Binding #Root.((vm:TransactionsViewModel)DataContext).UnvoidCommand}"
                                                        CommandParameter="{Binding}" />

                                                <!-- Attach a file (TD-141, FR-TXN-02). Opens the file picker the
                                                     view supplies; always available, since any transaction may
                                                     gain evidence. -->
                                                <Button Classes="pine-outline"
                                                        Content="{loc:Tr Transactions.AttachAction}"
                                                        FontSize="12" MinHeight="36" Padding="10,6" Margin="0,0,0,6"
                                                        AutomationProperties.Name="{loc:Tr Transactions.AttachAutomationName}"
                                                        Command="{Binding #Root.((vm:TransactionsViewModel)DataContext).AttachFileCommand}"
                                                        CommandParameter="{Binding}" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Infinite Scroll / Load More Placeholder -->
                        <Button Content="{loc:Tr Transactions.LoadMore}" Command="{Binding LoadNextPageCommand}"
                                IsVisible="{Binding HasMorePages}"
                                HorizontalAlignment="Center" Margin="0,20,0,10" Classes="pine-nav" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" Margin="0,10,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Dialog Overlay -->
        <Border Background="{DynamicResource PineScrim}" IsVisible="{Binding IsAddTransactionDialogVisible}">
            <ContentControl Content="{Binding AddTransactionVm}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:AddTransactionViewModel}">
                        <views:AddTransactionView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

        <!-- Edit dialog (TD-68) -->
        <Border Background="{DynamicResource PineScrim}" IsVisible="{Binding IsEditTransactionDialogVisible}">
            <ContentControl Content="{Binding EditTransactionVm}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:EditTransactionViewModel}">
                        <views:EditTransactionView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

        <!-- Void confirmation -->
        <Border Background="{DynamicResource PineScrim}" IsVisible="{Binding IsVoidDialogVisible}">
            <Border Width="440" Padding="28" CornerRadius="14"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource PineSurface}"
                    BorderBrush="{DynamicResource PineBorder}"
                    BorderThickness="1"
                    BoxShadow="0 8 32 0 #30000000">
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Tr Transactions.VoidDialog.Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding VoidTarget.Payee}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource PineText}" />
                        <TextBlock Text="{Binding VoidTarget.TotalAmount}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PineTextMuted}"
                               Text="{loc:Tr Transactions.VoidDialog.Explanation}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr Transactions.VoidDialog.ReasonLabel}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource PineText}" />
                        <TextBox Text="{Binding VoidReason}" MaxLength="256"
                                 PlaceholderText="{loc:Tr Transactions.VoidDialog.ReasonPlaceholder}"
                                 AutomationProperties.Name="{loc:Tr Transactions.VoidDialog.ReasonAutomationName}"
                                 IsEnabled="{Binding !IsVoiding}" />
                    </StackPanel>

                    <TextBlock Text="{Binding VoidError}" IsVisible="{Binding VoidError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PineError}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="{loc:Tr Transactions.VoidDialog.Cancel}" Classes="pine-outline" Padding="16,9"
                                Command="{Binding CancelVoidCommand}" IsEnabled="{Binding !IsVoiding}" />
                        <Button Content="{loc:Tr Transactions.VoidDialog.Confirm}" Classes="pine-danger" Padding="16,9"
                                Command="{Binding ConfirmVoidCommand}" IsEnabled="{Binding !IsVoiding}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- The receipt viewer, reusing the same lightbox the scan screen uses. Remove sits inside
             it on purpose: deleting evidence should only be possible while looking at it. -->
        <controls:ImageLightbox Source="{Binding ReceiptImage}" IsOpen="{Binding IsReceiptOpen}" />

        <Button Content="{loc:Tr Transactions.RemoveReceipt}"
                Classes="pine-danger" Padding="16,9"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32"
                ZIndex="101"
                IsVisible="{Binding IsReceiptOpen}"
                AutomationProperties.Name="{loc:Tr Transactions.RemoveReceiptAutomationName}"
                Command="{Binding RemoveReceiptCommand}" />
    </Grid>
</UserControl>
