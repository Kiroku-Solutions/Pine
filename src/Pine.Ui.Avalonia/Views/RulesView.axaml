<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             xmlns:conv="using:Pine.Ui.Avalonia.Utils"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Pine.Ui.Avalonia.Views.RulesView"
             x:DataType="vm:RulesViewModel">

    <ScrollViewer>
        <StackPanel x:Name="ContentStack" Spacing="24" Margin="40">

            <StackPanel Spacing="4">
                <TextBlock x:Name="RulesTitle" Text="{loc:Tr Rules.Title}" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource PineText}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Tr Rules.Subtitle}" FontSize="14"
                           Foreground="{DynamicResource PineTextMuted}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- The form. The first condition is always present; further ones (up to the engine's
                 eight, TD-143) are added below it and ANDed. -->
            <Border x:Name="FormCard" Background="{DynamicResource PineSurface}"
                    BorderBrush="{DynamicResource PineBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{loc:Tr Rules.New.Section}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource PineText}" />
                    <Border Height="1" Background="{DynamicResource PineBorder}" />

                    <Grid x:Name="TitleCategoryGrid" ColumnDefinitions="*, 12, *" RowDefinitions="Auto, Auto">
                        <StackPanel x:Name="TitleFieldStack" Grid.Column="0" Grid.Row="0" Spacing="4">
                            <TextBlock Text="{loc:Tr Rules.New.TitleLabel}" FontSize="13"
                                       Foreground="{DynamicResource PineTextMuted}" />
                            <TextBox Text="{Binding NewTitle}"
                                     PlaceholderText="{loc:Tr Rules.New.TitlePlaceholder}"
                                     AutomationProperties.Name="{loc:Tr Rules.New.TitleLabel}" />
                        </StackPanel>

                        <StackPanel x:Name="CategoryFieldStack" Grid.Column="2" Grid.Row="0" Spacing="4">
                            <TextBlock Text="{loc:Tr Rules.New.CategoryLabel}" FontSize="13"
                                       Foreground="{DynamicResource PineTextMuted}" />
                            <TextBox Text="{Binding NewCategory}"
                                     PlaceholderText="{loc:Tr Rules.New.CategoryPlaceholder}"
                                     AutomationProperties.Name="{loc:Tr Rules.New.CategoryLabel}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PrimaryConditionGrid" ColumnDefinitions="Auto, 12, Auto, 12, *, 12, Auto">
                        <!-- TD-150: a bare ItemsSource over these enums rendered the raw member
                             name ("Payee", "GreaterThan", ...) instead of the same Rules.Field.*/
                             Rules.Operator.* words the condition summary already renders through. -->
                        <ComboBox x:Name="FieldCombo" Grid.Column="0" ItemsSource="{Binding Fields}"
                                  SelectedItem="{Binding SelectedField}" MinWidth="130" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{loc:Tr Rules.New.FieldLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static conv:Converters.RuleFieldDisplay}">
                                                <Binding />
                                                <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="OperatorCombo" Grid.Column="2" ItemsSource="{Binding Operators}"
                                  SelectedItem="{Binding SelectedOperator}" MinWidth="140" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{loc:Tr Rules.New.OperatorLabel}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static conv:Converters.RuleOperatorDisplay}">
                                                <Binding />
                                                <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox x:Name="ValueBox" Grid.Column="4" Text="{Binding NewValue}"
                                 PlaceholderText="{loc:Tr Rules.New.ValuePlaceholder}"
                                 AutomationProperties.Name="{loc:Tr Rules.New.ValueLabel}" />
                        <NumericUpDown x:Name="PriorityBox" Grid.Column="6" Value="{Binding NewPriority}"
                                       Minimum="0" Maximum="1000" Increment="10" MinWidth="120" HorizontalAlignment="Stretch"
                                       AutomationProperties.Name="{loc:Tr Rules.New.PriorityLabel}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding AdditionalConditions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ConditionDraftViewModel">
                                <Grid ColumnDefinitions="Auto, 12, Auto, 12, *, 12, Auto" Margin="0,0,0,8">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding $parent[ItemsControl].((vm:RulesViewModel)DataContext).Fields}"
                                              SelectedItem="{Binding Field}" MinWidth="130"
                                              AutomationProperties.Name="{loc:Tr Rules.New.FieldLabel}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{x:Static conv:Converters.RuleFieldDisplay}">
                                                            <Binding />
                                                            <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding $parent[ItemsControl].((vm:RulesViewModel)DataContext).Operators}"
                                              SelectedItem="{Binding Operator}" MinWidth="140"
                                              AutomationProperties.Name="{loc:Tr Rules.New.OperatorLabel}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{x:Static conv:Converters.RuleOperatorDisplay}">
                                                            <Binding />
                                                            <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="4" Text="{Binding Value}"
                                             PlaceholderText="{loc:Tr Rules.New.ValuePlaceholder}"
                                             AutomationProperties.Name="{loc:Tr Rules.New.ValueLabel}" />
                                    <Button Grid.Column="6" Classes="pine-danger" FontSize="12" Padding="10,5"
                                            Content="{loc:Tr Rules.New.RemoveCondition}"
                                            AutomationProperties.Name="{loc:Tr Rules.New.RemoveConditionAutomationName}"
                                            Command="{Binding $parent[ItemsControl].((vm:RulesViewModel)DataContext).RemoveConditionCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{loc:Tr Rules.New.AddCondition}" HorizontalAlignment="Left"
                            Padding="12,6" IsEnabled="{Binding CanAddCondition}"
                            Command="{Binding AddConditionCommand}" />

                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource PineDanger}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Button Content="{loc:Tr Rules.New.CreateButton}" Classes="pine-accent"
                            Padding="16,9" HorizontalAlignment="Right"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding CreateRuleCommand}" />
                </StackPanel>
            </Border>

            <!-- Retroactive application (TD-142): preview first, then apply exactly what was shown. -->
            <Border Background="{DynamicResource PineSurface}"
                    BorderBrush="{DynamicResource PineBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{loc:Tr Rules.Preview.Section}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource PineText}" />
                    <Border Height="1" Background="{DynamicResource PineBorder}" />
                    <TextBlock Text="{loc:Tr Rules.Preview.Subtitle}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource PineTextMuted}" />

                    <Button Content="{loc:Tr Rules.Preview.Button}" HorizontalAlignment="Left"
                            Padding="16,9" IsEnabled="{Binding !IsBusy}"
                            Command="{Binding PreviewRulesCommand}" />

                    <TextBlock Text="{Binding PreviewSummary}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource PineText}"
                               IsVisible="{Binding PreviewSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <ScrollViewer MaxHeight="320" IsVisible="{Binding HasPreview}">
                        <ItemsControl ItemsSource="{Binding PreviewRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:RulePreviewRowViewModel">
                                    <Border BorderBrush="{DynamicResource PineBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Description}" FontSize="13"
                                                       Foreground="{DynamicResource PineText}" />
                                            <TextBlock Text="{Binding Change}" FontSize="12"
                                                       Foreground="{DynamicResource PineTextMuted}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasPreview}">
                        <Button Content="{loc:Tr Rules.Preview.Apply}" Classes="pine-accent" Padding="16,9"
                                IsEnabled="{Binding CanApplyPreview}"
                                Command="{Binding ApplyPreviewCommand}" />
                        <Button Content="{loc:Tr Rules.Preview.Discard}" Padding="16,9"
                                Command="{Binding DiscardPreviewCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The list, in the order the rules actually fire. -->
            <Border Background="{DynamicResource PineSurface}"
                    BorderBrush="{DynamicResource PineBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{loc:Tr Rules.List.Section}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource PineText}" />
                    <Border Height="1" Background="{DynamicResource PineBorder}" />

                    <TextBlock Text="{loc:Tr Rules.List.Empty}" FontSize="13"
                               Foreground="{DynamicResource PineTextMuted}"
                               IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:RuleRowViewModel">
                                <Border BorderBrush="{DynamicResource PineBorder}" BorderThickness="0,0,0,1"
                                        Padding="0,12">
                                    <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Medium"
                                                       Foreground="{DynamicResource PineText}" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PineTextMuted}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="16,0"
                                                   Foreground="{DynamicResource PineText}" />

                                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                      VerticalAlignment="Center" Margin="8,0"
                                                      AutomationProperties.Name="{loc:Tr Rules.List.ToggleAutomationName}"
                                                      Command="{Binding $parent[ItemsControl].((vm:RulesViewModel)DataContext).ToggleRuleCommand}"
                                                      CommandParameter="{Binding}" />

                                        <Button Grid.Column="3" Classes="pine-danger" FontSize="12" Padding="10,5"
                                                VerticalAlignment="Center"
                                                Content="{loc:Tr Rules.List.Delete}"
                                                AutomationProperties.Name="{loc:Tr Rules.List.DeleteAutomationName}"
                                                Command="{Binding $parent[ItemsControl].((vm:RulesViewModel)DataContext).DeleteRuleCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
