<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="Pine.Ui.Avalonia.Views.CreateAccountView"
             x:DataType="vm:CreateAccountViewModel">

    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="30"
            BoxShadow="0 10 30 0 #40000000"
            MaxWidth="400" MaxHeight="550"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            
        <StackPanel Spacing="15">
            <TextBlock Text="Add Account" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10" />
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />

            <StackPanel Spacing="5">
                <TextBlock Text="Account Name" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{Binding AccountName}" PlaceholderText="e.g. Main Checking" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Account Type" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding SelectedType}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <Grid ColumnDefinitions="*, 10, *">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="Currency" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
                
                <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Text="Initial Balance" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <NumericUpDown Value="{Binding InitialBalance}" FormatString="0.00" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
            
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,10,0,0" />

            <Grid ColumnDefinitions="*, 10, *" Margin="0,20,0,0">
                <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                <Button Grid.Column="2" Content="Create" Command="{Binding CreateCommand}" Classes="pine-accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
