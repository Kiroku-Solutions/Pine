<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             xmlns:conv="using:Pine.Ui.Avalonia.Utils"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="Pine.Ui.Avalonia.Views.CreateAccountView"
             x:DataType="vm:CreateAccountViewModel">

    <Border Background="{DynamicResource PineSurface}"
            Classes="reveal"
            CornerRadius="14"
            BorderBrush="{DynamicResource PineBorder}"
            BorderThickness="1"
            Margin="12"
            Padding="20"
            BoxShadow="0 8 24 0 #20000000"
            MaxWidth="420" MaxHeight="580"
            HorizontalAlignment="Stretch" VerticalAlignment="Center">

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
            <TextBlock Text="{loc:Tr CreateAccount.Title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource PineText}" TextWrapping="Wrap" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource PineError}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />

            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Tr CreateAccount.Name.Label}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                <TextBox Text="{Binding AccountName}" PlaceholderText="{loc:Tr CreateAccount.Name.Placeholder}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Tr CreateAccount.Type.Label}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding SelectedType}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
                    <!-- TD-150: a bare ItemsSource over the enum rendered its raw member name
                         ("Cash", "Bank", and so on): correct English, never translated. -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:Converters.AccountTypeDisplay}">
                                        <Binding />
                                        <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="*, 10, *">
                <StackPanel Grid.Column="0" Spacing="5" IsEnabled="{Binding !IsBusy}">
                    <TextBlock Text="{loc:Tr CreateAccount.Currency.Label}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                    <!-- TD-76: a searchable picker over every ISO 4217 code. Type a code or a name; Up/Down
                         move through the matches, Enter picks, Esc closes. The view model filters
                         (FilterMode None), so the logic is unit-tested without a window. -->
                    <AutoCompleteBox x:Name="CurrencyBox"
                                     DataContext="{Binding CurrencyPicker}"
                                     ItemsSource="{Binding Matches}"
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                     FilterMode="None"
                                     MinimumPrefixLength="0"
                                     MaxDropDownHeight="240"
                                     PlaceholderText="{loc:Tr CreateAccount.Currency.Placeholder}"
                                     AutomationProperties.Name="{loc:Tr CreateAccount.Currency.Label}"
                                     HorizontalAlignment="Stretch">
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CurrencyChoice">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Text="{loc:Tr CreateAccount.InitialBalance.Label}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                    <NumericUpDown Value="{Binding InitialBalance}" FormatString="0.00" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
            
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,10,0,0" />

            <Grid ColumnDefinitions="*, 10, *" Margin="0,20,0,0">
                <Button Grid.Column="0" Content="{loc:Tr CreateAccount.CancelButton}" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                <Button Grid.Column="2" Content="{loc:Tr CreateAccount.CreateButton}" Command="{Binding CreateCommand}" Classes="pine-accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
            </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>
</UserControl>
