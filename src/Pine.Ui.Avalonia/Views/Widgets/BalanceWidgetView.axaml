<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels.Widgets"
             xmlns:core="using:Pine.Core.Accounts"
             xmlns:conv="using:Pine.Ui.Avalonia.Utils"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             x:Class="Pine.Ui.Avalonia.Views.Widgets.BalanceWidgetView"
             x:DataType="vm:BalanceWidgetViewModel">
    
    <Grid RowDefinitions="Auto, *">
        <TextBlock Grid.Row="0" Text="{Binding FailureMessage}" IsVisible="{Binding HasFailed}"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PineDanger}" Margin="10,0,10,6" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="core:Account">
                        <Border Padding="10,8" Margin="0,0,0,5" CornerRadius="6" Background="{DynamicResource PineSurfaceElevated}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <!-- Placeholder Icon -->
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource PineAccentHover}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name, Converter={x:Static conv:Converters.InitialLetter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PineText}"/>
                                </Border>
                                
                                <!-- Account Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource PineText}" />
                                    <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" />
                                </StackPanel>
                                
                                <!-- Balance -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Balance, Converter={x:Static conv:Converters.MoneyAmount}}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PineText}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding Balance.Currency.Value}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
            </ItemsControl>
        </ScrollViewer>
            
        <!-- Bound to IsEmpty, not to the count (item 1.3): an empty list before the first read, or after
             a failed one, is not "you have none". -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,0" IsVisible="{Binding IsEmpty}">
            <TextBlock Text="{loc:Tr BalanceWidget.EmptyState}" Foreground="{DynamicResource PineTextMuted}" FontSize="13" />
        </StackPanel>
    </Grid>
</UserControl>
