<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels.Widgets"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             x:Class="Pine.Ui.Avalonia.Views.Widgets.BalanceWidgetView"
             x:DataType="vm:BalanceWidgetViewModel">

    <Grid RowDefinitions="Auto, *" Margin="10,0,10,10">
        <TextBlock Grid.Row="0" Text="{Binding FailureMessage}" IsVisible="{Binding HasFailed}"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PineDanger}" Margin="0,0,0,6" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AccountRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountBalanceShareRow">
                        <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="10"
                                Background="{DynamicResource PineSurfaceElevated}"
                                BorderBrush="{DynamicResource PineBorder}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{Binding AccentBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding InitialLetter}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontWeight="Bold"
                                                   Foreground="{DynamicResource PineButtonText}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource PineText}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Border Classes="pine-pill-info" VerticalAlignment="Center"
                                                    IsVisible="{Binding HasHierarchyBadge}">
                                                <TextBlock Text="{Binding HierarchyBadgeText}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PineInfo}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ShareText}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding BalanceText}" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource PineText}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding CurrencyCode}" FontSize="11"
                                                   Foreground="{DynamicResource PineTextMuted}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <!-- Share of Total Balance Bar -->
                                <ProgressBar Value="{Binding SharePercentage}" Maximum="100" Height="6" CornerRadius="3"
                                             Background="{DynamicResource PineChartTrack}" Foreground="{Binding AccentBrush}" />

                                <!-- Scoped Budget Remaining Pill (if linked) -->
                                <Border Classes="pine-pill-info" HorizontalAlignment="Left" IsVisible="{Binding HasBudgetLeft}">
                                    <TextBlock Text="{Binding BudgetLeftText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PineInfo}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,0" IsVisible="{Binding IsEmpty}">
            <TextBlock Text="{loc:Tr BalanceWidget.EmptyState}" Foreground="{DynamicResource PineTextMuted}" FontSize="13" />
        </StackPanel>
    </Grid>
</UserControl>
