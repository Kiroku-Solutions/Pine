<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels.Widgets"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             x:Class="Pine.Ui.Avalonia.Views.Widgets.CashFlowWidgetView"
             x:DataType="vm:CashFlowWidgetViewModel">

    <Grid RowDefinitions="Auto, *, Auto" Margin="10,0,10,10">
        <TextBlock Grid.Row="0" Text="{Binding FailureMessage}" IsVisible="{Binding HasFailed}"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PineDanger}" Margin="0,0,0,6" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasActivity}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CashFlowRow">
                        <StackPanel Spacing="8" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Currency}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PineTextMuted}" />
                                    <TextBlock Text="{Binding SpentRatioText}" FontSize="11" Foreground="{DynamicResource PineTextMuted}"
                                               IsVisible="{Binding SpentRatioText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="pine-pill-success" Classes.pine-pill-danger="{Binding IsNetNegative}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{loc:Tr Dashboard.CashFlow.Net}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" />
                                        <TextBlock Text="{Binding Net}" FontSize="12" FontWeight="Bold"
                                                   Classes="net" Classes.negative="{Binding IsNetNegative}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Income Bar -->
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Dashboard.CashFlow.Income}" FontSize="12" Foreground="{DynamicResource PineTextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Income}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PineSuccess}" />
                                </Grid>
                                <ProgressBar Value="{Binding IncomeBarPercent}" Maximum="100" Height="8" CornerRadius="4"
                                             Background="{DynamicResource PineChartTrack}" Foreground="{DynamicResource PineSuccess}" />
                            </StackPanel>

                            <!-- Spending Bar -->
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Dashboard.CashFlow.Spending}" FontSize="12" Foreground="{DynamicResource PineTextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Spending}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PineDanger}" />
                                </Grid>
                                <ProgressBar Value="{Binding SpendingBarPercent}" Maximum="100" Height="8" CornerRadius="4"
                                             Background="{DynamicResource PineChartTrack}" Foreground="{DynamicResource PineDanger}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="{loc:Tr Dashboard.CashFlow.Empty}" IsVisible="{Binding IsEmpty}"
                   TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="13" Foreground="{DynamicResource PineTextMuted}" />

        <TextBlock Grid.Row="2" Text="{loc:Tr Dashboard.CashFlow.Note}" TextWrapping="Wrap"
                   FontSize="11" Foreground="{DynamicResource PineTextMuted}" Margin="0,6,0,0" />
    </Grid>

    <UserControl.Styles>
        <Style Selector="TextBlock.net">
            <Setter Property="Foreground" Value="{DynamicResource PineSuccess}" />
        </Style>
        <Style Selector="TextBlock.net.negative">
            <Setter Property="Foreground" Value="{DynamicResource PineDanger}" />
        </Style>
    </UserControl.Styles>
</UserControl>
