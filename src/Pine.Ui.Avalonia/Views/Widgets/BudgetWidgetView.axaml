<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels.Widgets"
             xmlns:pvm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             x:Class="Pine.Ui.Avalonia.Views.Widgets.BudgetWidgetView"
             x:DataType="vm:BudgetWidgetViewModel">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="10,0,10,10">
        <TextBlock Grid.Row="0" Text="{Binding FailureMessage}" IsVisible="{Binding HasFailed}"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PineDanger}" Margin="0,0,0,6" />

        <Border Grid.Row="1" Classes="pine-pill-danger" HorizontalAlignment="Left" Margin="0,0,0,8"
                IsVisible="{Binding ExceededText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ExceededText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PineDanger}" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasBudgets}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pvm:BudgetProgressViewModel">
                        <StackPanel Margin="0,0,0,12" Spacing="5">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource PineText}" TextTrimming="CharacterEllipsis" />
                                    <Border Classes="pine-pill-info" IsVisible="{Binding HasAccountScope}">
                                        <TextBlock Text="{Binding AccountName}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PineInfo}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PercentBadgeText}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource PineTextMuted}" VerticalAlignment="Center" />
                            </Grid>

                            <ProgressBar Classes="pine-bar" Height="8" CornerRadius="4"
                                         Value="{Binding ClampedProgressPercentage}" Maximum="100"
                                         IsVisible="{Binding IsSpendKnown}"
                                         Classes.nearLimit="{Binding IsNearLimit}"
                                         Classes.overBudget="{Binding IsExceeded}" />

                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="{Binding SpentAmountText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                                    <TextBlock Text="{loc:Tr Budgets.Progress.Of}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" />
                                    <TextBlock Text="{Binding LimitAmountText}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" />
                                    <TextBlock Text="{Binding CurrencyCode}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding RemainingStatusText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PineSuccess}" IsVisible="{Binding !IsExceeded}" />
                                <TextBlock Grid.Column="1" Text="{Binding RemainingStatusText}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource PineDanger}" IsVisible="{Binding IsExceeded}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{loc:Tr Dashboard.Budgets.Empty}" IsVisible="{Binding IsEmpty}"
                   TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="13" Foreground="{DynamicResource PineTextMuted}" />

        <TextBlock Grid.Row="3" Text="{Binding MoreText}" IsVisible="{Binding MoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   FontSize="11" Foreground="{DynamicResource PineTextMuted}" Margin="0,4,0,0" />
    </Grid>
</UserControl>
