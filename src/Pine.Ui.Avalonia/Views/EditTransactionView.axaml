<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="600"
             x:Class="Pine.Ui.Avalonia.Views.EditTransactionView"
             x:DataType="vm:EditTransactionViewModel">

    <Border CornerRadius="12"
            Classes="reveal"
            MaxWidth="450" MaxHeight="650"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource PineSurface}"
            BorderBrush="{DynamicResource PineBorder}" BorderThickness="1"
            Padding="30"
            BoxShadow="0 8 24 0 #20000000">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="15">
                <TextBlock Text="{loc:Tr EditTransaction.Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource PineText}" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource PineError}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />

            <!-- Income / Expense toggle. No Transfer option: Transaction.Update refuses a transfer
                 leg, and the Edit button never opens this dialog on one. -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,0,0,10">
                <RadioButton Content="{loc:Tr AddTransaction.TypeExpense}" IsChecked="{Binding !IsIncome}" GroupName="EditTxType" />
                <RadioButton Content="{loc:Tr AddTransaction.TypeIncome}" IsChecked="{Binding IsIncome}" GroupName="EditTxType" />
            </StackPanel>

            <!-- Account is shown, not edited: moving a transaction to a different account is a
                 transfer, not an edit (see Transaction.Update's remarks). -->
            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Tr EditTransaction.AccountLabel}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                <TextBlock Text="{Binding Account.Name}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource PineText}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Tr AddTransaction.DateLabel}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Tr AddTransaction.AmountLabel}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                <NumericUpDown Value="{Binding Amount}" FormatString="0.00" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" Minimum="0" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Tr AddTransaction.PayeeLabel}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                <TextBox Text="{Binding Payee}" PlaceholderText="{loc:Tr AddTransaction.PayeePlaceholder}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Tr AddTransaction.CategoryLabel}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                <TextBox Text="{Binding Category}" PlaceholderText="{loc:Tr AddTransaction.CategoryPlaceholder}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Tr AddTransaction.NotesLabel}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                <TextBox Text="{Binding Notes}" PlaceholderText="{loc:Tr AddTransaction.NotesPlaceholder}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,10,0,0" />

            <Grid ColumnDefinitions="*, 10, *" Margin="0,20,0,0">
                <Button Grid.Column="0" Content="{loc:Tr AddTransaction.CancelButton}" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                <Button Grid.Column="2" Content="{loc:Tr EditTransaction.SaveButton}" Command="{Binding SaveCommand}" Classes="pine-accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
            </Grid>
            </StackPanel>
          </ScrollViewer>
    </Border>
</UserControl>
