<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:core="using:Pine.Core.Accounts"
             xmlns:controls="using:Pine.Ui.Avalonia.Controls"
             xmlns:conv="using:Pine.Ui.Avalonia.Utils"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Pine.Ui.Avalonia.Views.ScanReceiptView"
             x:DataType="vm:ScanReceiptViewModel">

  <UserControl.Styles>
    <Style Selector="Button.tag-field-chip">
      <Setter Property="Background" Value="{DynamicResource PineSurfaceElevated}" />
      <Setter Property="Foreground" Value="{DynamicResource PineText}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tag-field-chip.active">
      <Setter Property="Background" Value="{DynamicResource PinePrimary}" />
      <Setter Property="Foreground" Value="{DynamicResource PineButtonText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PinePrimary}" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
    <Border x:Name="Card" CornerRadius="12"
            MaxWidth="1100"
            HorizontalAlignment="Center" VerticalAlignment="Stretch"
            Background="{DynamicResource PineSurface}"
            BorderBrush="{DynamicResource PineBorder}" BorderThickness="1"
            Padding="30"
            Margin="0,20"
            BoxShadow="0 8 24 0 #20000000">

        <Grid x:Name="Cols" ColumnDefinitions="*, 30, 400">
            <!-- Left Side: Image Preview & Actions -->
            <StackPanel x:Name="LeftPane" Grid.Column="0" Spacing="15">
                <TextBlock Text="{loc:Tr ScanReceipt.Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                <TextBlock Text="{loc:Tr ScanReceipt.Description}"
                           TextWrapping="Wrap" Foreground="{DynamicResource PineTextMuted}" />
                
                <Border x:Name="Preview" CornerRadius="8" Background="{DynamicResource PineSurfaceElevated}" BorderBrush="{DynamicResource PineBorder}" BorderThickness="1"
                        Height="400" VerticalAlignment="Stretch" ClipToBounds="True">
                    <Grid>
                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" 
                                    IsVisible="{Binding ReceiptImage, Converter={x:Static ObjectConverters.IsNull}}">
                            <PathIcon Data="{StaticResource image_regular}" Width="48" Height="48" Foreground="{DynamicResource PineTextMuted}" />
                            <TextBlock Text="{loc:Tr ScanReceipt.Image.Empty}" Foreground="{DynamicResource PineTextMuted}" />
                        </StackPanel>
                        
                        <!-- Image Preview (click to enlarge) -->
                        <Image Source="{Binding ReceiptImage}" Stretch="Uniform"
                               Cursor="Hand" PointerPressed="OnPreviewImageClicked" />

                        <!-- Viewfinder while the device camera is open (Android). Frames stay in memory. -->
                        <controls:QuadEditorControl Source="{Binding LiveFeed}" Quad="{Binding LiveQuad}" IsEditable="False"
                                                    IsVisible="{Binding IsCameraOpen}" />
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8"
                                Background="{DynamicResource PineScrim}" CornerRadius="6" Padding="10,6"
                                IsHitTestVisible="False" IsVisible="{Binding IsCameraOpen}">
                            <TextBlock Text="{Binding LiveStatus}" Foreground="White" FontSize="13" TextWrapping="Wrap" />
                        </Border>

                        <!-- Enlarge hint -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8"
                                Background="{DynamicResource PineScrim}" CornerRadius="6" Padding="8,4"
                                IsHitTestVisible="False"
                                IsVisible="{Binding ReceiptImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{loc:Tr ScanReceipt.Image.EnlargeHint}" Foreground="White" FontSize="12" FontWeight="Medium" />
                        </Border>
                    </Grid>
                </Border>
                
                <UniformGrid Rows="1">
                    <Button Margin="0,0,5,0" Content="{loc:Tr ScanReceipt.SelectImage}" x:Name="SelectImageButton" Click="OnSelectImageClicked"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                    <Button Margin="5,0,0,0" Content="{loc:Tr ScanReceipt.RetakePhoto}" Command="{Binding RetakeCommand}" IsVisible="{Binding HasLiveScanner}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                </UniformGrid>

                <!-- Interactive bounding-box tagging & local model training -->
                <Button Content="{loc:Tr ScanReceipt.Tagging.OpenButton}"
                        Command="{Binding OpenTagEditorCommand}"
                        IsVisible="{Binding ReceiptImage, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Classes="pine-outline"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        MinHeight="44" CornerRadius="10"
                        IsEnabled="{Binding !IsBusy}" />

                <Border IsVisible="{Binding TrainingBannerMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="{DynamicResource PineSuccessContainer}"
                        CornerRadius="8" Padding="10,8">
                    <TextBlock Text="{Binding TrainingBannerMessage}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource PineSuccess}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Take the photo with the device camera (heads with a camera source and no live scanner page). -->
                <Grid ColumnDefinitions="*, 10, *" IsVisible="{Binding HasCameraCapture}">
                    <Button Grid.Column="0" Content="{loc:Tr ScanReceipt.LiveScan}" Command="{Binding OpenCameraCommand}"
                            IsVisible="{Binding !IsCameraOpen}" Grid.ColumnSpan="3"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                    <Button Grid.Column="0" Content="{loc:Tr ScanReceipt.Camera.Capture}" Command="{Binding CapturePhotoCommand}"
                            IsVisible="{Binding IsCameraOpen}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="{loc:Tr ScanReceipt.Camera.Close}" Command="{Binding CloseCameraCommand}"
                            IsVisible="{Binding IsCameraOpen}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Right Side: Extracted Fields -->
            <Grid x:Name="RightPane" Grid.Column="2" RowDefinitions="*, Auto" VerticalAlignment="Stretch">

                <!-- Scrollable field area — prevents overlap when the panel is short -->
                <ScrollViewer x:Name="FieldsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel Spacing="16">

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr ScanReceipt.ExtractedDetails}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                            <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Background="{DynamicResource PineDangerContainer}" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource PineError}" TextWrapping="Wrap" FontSize="13" />
                            </Border>
                            <!-- Non-blocking (TD-20): a second press with unchanged inputs still saves. -->
                            <Border IsVisible="{Binding DuplicateWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Background="{DynamicResource PineSurface}" BorderBrush="{DynamicResource PineWarning}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="{Binding DuplicateWarning}" Foreground="{DynamicResource PineWarning}" TextWrapping="Wrap" FontSize="13" />
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Tr ScanReceipt.Field.Account}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:Account">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Tr ScanReceipt.Field.Merchant}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                            <TextBox Text="{Binding Merchant}" PlaceholderText="{loc:Tr ScanReceipt.Field.MerchantPlaceholder}" IsEnabled="{Binding !IsBusy}" />
                            <!-- Weak-read hint (TD-22): shown for Low and NotFound alike, but worded
                                 differently by ConfidenceHintText, one asks the user to check a
                                 value, the other to supply one. -->
                            <TextBlock IsVisible="{Binding MerchantConfidence, Converter={x:Static conv:Converters.IsWeakConfidence}}"
                                       FontSize="12" Foreground="{DynamicResource PineWarning}" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:Converters.ConfidenceHintText}">
                                        <Binding Path="MerchantConfidence" />
                                        <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <!-- Stacked vertically: the Fluent DatePicker has a 296px MinWidth
                             that overflows (and overlaps) a narrow star column. -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Tr ScanReceipt.Field.Date}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                            <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" />
                            <TextBlock IsVisible="{Binding DateConfidence, Converter={x:Static conv:Converters.IsWeakConfidence}}"
                                       FontSize="12" Foreground="{DynamicResource PineWarning}" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:Converters.ConfidenceHintText}">
                                        <Binding Path="DateConfidence" />
                                        <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- Date ambiguity (TD-21). A locale-ambiguous date like 05/03/2026 is
                                 never resolved on the user's behalf: both readings are shown, and
                                 the button only offers to swap which one is in Date, leaving
                                 IsDateAmbiguous set so the swap is reversible. -->
                            <Border IsVisible="{Binding IsDateAmbiguous}"
                                    Background="{DynamicResource PineSurfaceElevated}"
                                    BorderBrush="{DynamicResource PineWarning}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8">
                                <Grid ColumnDefinitions="*, 8, Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DateAmbiguityMessage}"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource PineText}" />
                                    <Button Grid.Column="2" Content="{loc:Tr ScanReceipt.UseAlternativeDate}"
                                            Command="{Binding UseAlternativeDateCommand}"
                                            Padding="8,4" FontSize="12"
                                            IsEnabled="{Binding !IsBusy}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Tr ScanReceipt.Field.Amount}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                            <NumericUpDown Value="{Binding Amount}" FormatString="0.00" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" Minimum="0" />
                            <TextBlock IsVisible="{Binding TotalConfidence, Converter={x:Static conv:Converters.IsWeakConfidence}}"
                                       FontSize="12" Foreground="{DynamicResource PineWarning}" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{x:Static conv:Converters.ConfidenceHintText}">
                                        <Binding Path="TotalConfidence" />
                                        <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Tr ScanReceipt.Field.Tax}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                            <NumericUpDown Value="{Binding TaxTotal}" FormatString="0.00" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" Minimum="0" />
                            <CheckBox IsChecked="{Binding IsTaxIncluded}" Content="{loc:Tr ScanReceipt.Field.TaxIncluded}" FontSize="12" IsEnabled="{Binding !IsBusy}" />
                            <TextBlock IsVisible="{Binding TaxWarningMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Text="{Binding TaxWarningMessage}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource PineWarning}" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Tr ScanReceipt.Field.Category}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
                            <TextBox Text="{Binding Category}" PlaceholderText="{loc:Tr ScanReceipt.Field.CategoryPlaceholder}" IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>

                        <!-- Line Items — Mobile-first directly editable cards (replaces cramped touch-unfriendly DataGrid) -->
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{loc:Tr ScanReceipt.LineItems.Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{loc:Tr ScanReceipt.LineItems.Add}" Command="{Binding AddLineItemCommand}"
                                        Classes="pine-outline" MinHeight="38" Padding="12,6" CornerRadius="8" FontSize="13" IsEnabled="{Binding !IsBusy}" />
                            </Grid>

                            <Border IsVisible="{Binding !HasLineItems}"
                                    Background="{DynamicResource PineSurfaceElevated}"
                                    BorderBrush="{DynamicResource PineBorder}" BorderThickness="1"
                                    CornerRadius="10" Padding="12,10">
                                <TextBlock Text="{loc:Tr ScanReceipt.LineItems.EmptyHint}"
                                           FontSize="12" Foreground="{DynamicResource PineTextMuted}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding LineItems}" IsVisible="{Binding HasLineItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReceiptLineItemViewModel">
                                        <Border Background="{DynamicResource PineSurfaceElevated}"
                                                BorderBrush="{DynamicResource PineBorder}" BorderThickness="1"
                                                CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel Spacing="10">
                                                <!-- Row 0: Full-width editable description + Kind pill + Remove -->
                                                <Grid ColumnDefinitions="*, 8, Auto, 6, Auto">
                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding Description, Mode=TwoWay}"
                                                             PlaceholderText="{loc:Tr ScanReceipt.LineItems.DescriptionPlaceholder}"
                                                             AutomationProperties.Name="{loc:Tr ScanReceipt.LineItems.ColumnItem}"
                                                             MinHeight="40"
                                                             VerticalContentAlignment="Center"
                                                             IsEnabled="{Binding $parent[UserControl].((vm:ScanReceiptViewModel)DataContext).IsBusy, Converter={x:Static BoolConverters.Not}}" />

                                                    <Border Grid.Column="2"
                                                            Background="{DynamicResource PineInfoContainer}"
                                                            CornerRadius="6" Padding="8,4"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PineInfo}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{x:Static conv:Converters.LineItemKindDisplay}">
                                                                    <Binding Path="Kind" />
                                                                    <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>

                                                    <Button Grid.Column="4"
                                                            Command="{Binding $parent[UserControl].((vm:ScanReceiptViewModel)DataContext).RemoveLineItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            Classes="pine-outline"
                                                            Width="40" Height="40" Padding="0" CornerRadius="8"
                                                            ToolTip.Tip="{loc:Tr ScanReceipt.LineItems.RemoveTooltip}"
                                                            AutomationProperties.Name="{loc:Tr ScanReceipt.LineItems.RemoveAutomationName}"
                                                            Content="&#x2715;"
                                                            Foreground="{DynamicResource PineError}" FontWeight="Bold"
                                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                            IsEnabled="{Binding $parent[UserControl].((vm:ScanReceiptViewModel)DataContext).IsBusy, Converter={x:Static BoolConverters.Not}}" />
                                                </Grid>

                                                <!-- Row 1a (Products / Deposits): Editable Qty + Unit Price + live Total -->
                                                <Grid ColumnDefinitions="*, 8, 1.3*, 8, *" IsVisible="{Binding !IsAdjustment}">
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <TextBlock Text="{loc:Tr ScanReceipt.LineItems.ColumnQty}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" />
                                                        <NumericUpDown Value="{Binding Quantity, Mode=TwoWay}"
                                                                       Minimum="0.0001" Increment="1"
                                                                       FormatString="0.####"
                                                                       ShowButtonSpinner="False"
                                                                       MinHeight="40"
                                                                       HorizontalAlignment="Stretch"
                                                                       AutomationProperties.Name="{loc:Tr ScanReceipt.LineItems.ColumnQty}"
                                                                       IsEnabled="{Binding $parent[UserControl].((vm:ScanReceiptViewModel)DataContext).IsBusy, Converter={x:Static BoolConverters.Not}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Spacing="3">
                                                        <TextBlock Text="{loc:Tr ScanReceipt.LineItems.ColumnPrice}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" />
                                                        <NumericUpDown Value="{Binding UnitPrice, Mode=TwoWay}"
                                                                       Increment="1"
                                                                       FormatString="0.00"
                                                                       ShowButtonSpinner="False"
                                                                       MinHeight="40"
                                                                       HorizontalAlignment="Stretch"
                                                                       AutomationProperties.Name="{loc:Tr ScanReceipt.LineItems.ColumnPrice}"
                                                                       IsEnabled="{Binding $parent[UserControl].((vm:ScanReceiptViewModel)DataContext).IsBusy, Converter={x:Static BoolConverters.Not}}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Stretch">
                                                        <TextBlock Text="{loc:Tr ScanReceipt.LineItems.ColumnTotal}" FontSize="11" Foreground="{DynamicResource PineTextMuted}" HorizontalAlignment="Right" />
                                                        <Border Background="{DynamicResource PineSurface}"
                                                                BorderBrush="{DynamicResource PineBorder}" BorderThickness="1"
                                                                CornerRadius="6" Padding="8,0" MinHeight="40">
                                                            <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:0.00}'}"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       Foreground="{DynamicResource PineText}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Row 1b (Tax / Tip / Discount / Adjustments): Directly editable Total -->
                                                <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsAdjustment}">
                                                    <TextBlock Grid.Column="0" Text="{loc:Tr ScanReceipt.LineItems.ColumnTotal}" FontSize="12" Foreground="{DynamicResource PineTextMuted}" VerticalAlignment="Center" />
                                                    <NumericUpDown Grid.Column="1"
                                                                   Value="{Binding TotalPrice, Mode=TwoWay}"
                                                                   Increment="0.50"
                                                                   FormatString="0.00"
                                                                   ShowButtonSpinner="False"
                                                                   MinWidth="130" MinHeight="40"
                                                                   AutomationProperties.Name="{loc:Tr ScanReceipt.LineItems.ColumnTotal}"
                                                                   IsEnabled="{Binding $parent[UserControl].((vm:ScanReceiptViewModel)DataContext).IsBusy, Converter={x:Static BoolConverters.Not}}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Reconciliation (TD-19). The line items must add up to the total
                                 exactly; on a real receipt they do not, because tax, tips,
                                 discounts, deposits and cash rounding sit in between. Rather than
                                 tolerating a difference, this panel names it and offers to record
                                 it as a typed adjustment line. -->
                            <Border IsVisible="{Binding HasLineItems}"
                                    CornerRadius="8" Padding="12,10"
                                    Background="{DynamicResource PineSurfaceElevated}"
                                    BorderBrush="{DynamicResource PineBorder}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr ScanReceipt.Reconciliation.ItemsTotal}" FontSize="13"
                                                   Foreground="{DynamicResource PineTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProductsTotal}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr ScanReceipt.Reconciliation.AdjustmentsTotal}" FontSize="13"
                                                   Foreground="{DynamicResource PineTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding AdjustmentsTotal}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr ScanReceipt.Reconciliation.UnexplainedDifference}" FontSize="13"
                                                   Foreground="{DynamicResource PineTextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding UnreconciledDifference}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                                    </Grid>

                                    <Border IsVisible="{Binding !IsReconciled}"
                                            Background="{DynamicResource PineDangerContainer}"
                                            CornerRadius="6" Padding="10,8">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{loc:Tr ScanReceipt.Reconciliation.Warning}"
                                                       TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource PineError}" />
                                            <Grid ColumnDefinitions="*, 8, Auto">
                                                <!-- TD-150: a bare ItemsSource over this enum
                                                     rendered its raw member name. -->
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding AdjustmentKinds}"
                                                          SelectedItem="{Binding SelectedAdjustmentKind}"
                                                          HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="{loc:Tr ScanReceipt.Reconciliation.AdjustmentKindAutomationName}"
                                                          IsEnabled="{Binding !IsBusy}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock>
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{x:Static conv:Converters.LineItemKindDisplay}">
                                                                        <Binding />
                                                                        <Binding Path="CurrentCulture" Source="{x:Static loc:Localizer.Instance}" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="2" Content="{loc:Tr ScanReceipt.Reconciliation.RecordDifference}"
                                                        Command="{Binding RecordDifferenceAsAdjustmentCommand}"
                                                        Padding="10,4" FontSize="12"
                                                        IsEnabled="{Binding !IsBusy}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pinned action bar — Save/Cancel always visible -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="10">
                    <Grid ColumnDefinitions="*, 10, *">
                        <Button Grid.Column="0" Content="{loc:Tr ScanReceipt.Cancel}" Command="{Binding CancelCommand}" Classes="pine-outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                        <Button Grid.Column="2" Content="{loc:Tr ScanReceipt.SaveTransaction}" Command="{Binding SaveTransactionCommand}" Classes="pine-accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    </ScrollViewer>

    <!-- Edge editor (Android): the photo with the detected outline; drag a corner, then Crop and read. -->
    <Grid IsVisible="{Binding IsEditingEdges}" ZIndex="40" RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource PineBackground}">
      <StackPanel Grid.Row="0" Margin="16,12,16,8" Spacing="4">
        <TextBlock Text="{loc:Tr ScanReceipt.Edges.Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
        <TextBlock Text="{Binding EdgeHint}" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource PineTextMuted}" />
      </StackPanel>
      <controls:QuadEditorControl Grid.Row="1" Margin="8" Source="{Binding EdgeImage}" Quad="{Binding EdgeQuad, Mode=TwoWay}" IsEditable="True" />
      <Grid Grid.Row="2" Margin="16,8,16,16" ColumnDefinitions="*,8,*,8,*,8,2*">
        <Button Grid.Column="0" Content="{loc:Tr ScanReceipt.Edges.Rotate}" Command="{Binding RotateEdgesCommand}" Classes="pine-outline"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="2" Content="{loc:Tr ScanReceipt.Edges.Retry}" Command="{Binding RetryEdgesCommand}" Classes="pine-outline"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="4" Content="{loc:Tr ScanReceipt.Edges.Cancel}" Command="{Binding CancelEdgesCommand}" Classes="pine-outline"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
        <Button Grid.Column="6" Content="{loc:Tr ScanReceipt.Edges.Confirm}" Command="{Binding ConfirmEdgesCommand}" Classes="pine-accent"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
      </Grid>
    </Grid>

    <!--
      Busy overlay.

      IT COVERS THE CARD ON PURPOSE, and not only to look deliberate: while a scan runs, every
      control underneath is already disabled, and a scrim says so in one glance instead of asking
      the user to notice eight greyed-out fields. It also swallows clicks, so an impatient second
      press cannot queue behind the first.

      ZIndex sits below ImageLightbox's 100, so opening the full-size preview still wins.

      This overlay is only honest because the scan no longer runs on the UI thread. Rendered over a
      blocked UI thread it would be a frozen picture of a spinner, which reads worse than a plain
      unresponsive window — it looks broken rather than busy.
    -->
    <Border IsVisible="{Binding IsBusy}"
            ZIndex="50"
            Background="{DynamicResource PineScrim}"
            IsHitTestVisible="True">
      <Border Background="{DynamicResource PineSurface}"
              BorderBrush="{DynamicResource PineBorder}" BorderThickness="1"
              CornerRadius="12" Padding="28,24"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              MinWidth="300"
              BoxShadow="0 8 24 0 #40000000">
        <StackPanel Spacing="14" HorizontalAlignment="Center">

          <ProgressBar IsIndeterminate="True" Width="220" Height="4"
                       Foreground="{DynamicResource PinePrimary}" />

          <!-- The stage, in words. Never colour alone (40-Accessibility). -->
          <TextBlock Text="{Binding StatusMessage}"
                     FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource PineText}"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />

          <!-- Sets the expectation. The complaint this whole change answers was not "it is slow",
               it was "it looks broken" — and saying up front that seconds are normal is what
               separates the two. -->
          <TextBlock Text="{loc:Tr ScanReceipt.Busy.LargePhotoHint}"
                     FontSize="12"
                     Foreground="{DynamicResource PineTextMuted}"
                     HorizontalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Interactive Bounding-Box Tagging & Local Model Training Overlay -->
    <Grid IsVisible="{Binding IsEditingTags}" ZIndex="45" RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource PineBackground}">
      <StackPanel Grid.Row="0" Margin="16,12,16,8" Spacing="8">
        <TextBlock Text="{loc:Tr ScanReceipt.Tagging.Title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
        <TextBlock Text="{loc:Tr ScanReceipt.Tagging.Instruction}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource PineTextMuted}" />
        <WrapPanel Orientation="Horizontal">
          <Button Content="{loc:Tr ScanReceipt.Tagging.Field.Merchant}" Command="{Binding SelectTagFieldCommand}" CommandParameter="Merchant"
                  Classes="tag-field-chip" Classes.active="{Binding IsTagMerchantActive}"
                  BorderBrush="{DynamicResource PineSuccess}" />
          <Button Content="{loc:Tr ScanReceipt.Tagging.Field.Total}" Command="{Binding SelectTagFieldCommand}" CommandParameter="Total"
                  Classes="tag-field-chip" Classes.active="{Binding IsTagTotalActive}"
                  BorderBrush="{DynamicResource PineWarning}" />
          <Button Content="{loc:Tr ScanReceipt.Tagging.Field.Date}" Command="{Binding SelectTagFieldCommand}" CommandParameter="Date"
                  Classes="tag-field-chip" Classes.active="{Binding IsTagDateActive}"
                  BorderBrush="{DynamicResource PineInfo}" />
          <Button Content="{loc:Tr ScanReceipt.Tagging.Field.Tax}" Command="{Binding SelectTagFieldCommand}" CommandParameter="Tax"
                  Classes="tag-field-chip" Classes.active="{Binding IsTagTaxActive}"
                  BorderBrush="{DynamicResource PinePrimary}" />
        </WrapPanel>

        <!-- Live extracted previews from drawn boxes -->
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasTaggedBoxes}">
          <Border IsVisible="{Binding TagMerchantPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Background="{DynamicResource PineSuccessContainer}" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
            <TextBlock Text="{Binding TagMerchantPreview}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PineSuccess}" />
          </Border>
          <Border IsVisible="{Binding TagTotalPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Background="{DynamicResource PineWarningContainer}" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
            <TextBlock Text="{Binding TagTotalPreview}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PineWarning}" />
          </Border>
          <Border IsVisible="{Binding TagDatePreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Background="{DynamicResource PineInfoContainer}" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
            <TextBlock Text="{Binding TagDatePreview}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PineInfo}" />
          </Border>
          <Border IsVisible="{Binding TagTaxPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  Background="{DynamicResource PineSurfaceElevated}" BorderBrush="{DynamicResource PineBorder}" BorderThickness="1"
                  CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
            <TextBlock Text="{Binding TagTaxPreview}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
          </Border>
        </WrapPanel>
      </StackPanel>

      <controls:ReceiptTagOverlayControl Grid.Row="1" Margin="8"
                                         Source="{Binding TagEditorImage}"
                                         ActiveField="{Binding ActiveTagField}"
                                         TaggedBoxes="{Binding TaggedBoxes}"
                                         OcrWords="{Binding LastOcrWords}"
                                         OcrImageWidth="{Binding LastOcrImageWidth}"
                                         OcrImageHeight="{Binding LastOcrImageHeight}"
                                         FieldLabels="{Binding TagFieldLabels}"
                                         BoxDrawn="OnReceiptTagBoxDrawn" />

      <Grid Grid.Row="2" Margin="16,8,16,16" ColumnDefinitions="*,8,*,8,2*">
        <Button Grid.Column="0" Content="{loc:Tr ScanReceipt.Tagging.Clear}" Command="{Binding ClearTaggedBoxesCommand}"
                Classes="pine-outline" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Column="2" Content="{loc:Tr ScanReceipt.Tagging.Cancel}" Command="{Binding CancelTagEditorCommand}"
                Classes="pine-outline" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button Grid.Column="4" Content="{loc:Tr ScanReceipt.Tagging.ApplyAndTrain}" Command="{Binding ApplyTagsAndTrainCommand}"
                Classes="pine-accent" MinHeight="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </Grid>
    </Grid>

    <!-- Reusable full-size receipt viewer (zoom + pan) -->
    <controls:ImageLightbox Source="{Binding ReceiptImage}" IsOpen="{Binding IsImagePreviewOpen}" />
  </Grid>
</UserControl>
