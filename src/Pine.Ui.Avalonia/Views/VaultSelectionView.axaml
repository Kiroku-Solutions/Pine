<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:sec="using:Pine.Application.Security"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             x:DataType="vm:VaultSelectionViewModel"
             x:Class="Pine.Ui.Avalonia.Views.VaultSelectionView">

  <Design.DataContext>
    <vm:VaultSelectionViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto" Margin="40">
    <StackPanel Spacing="20" Margin="0,0,0,20">
      <TextBlock Text="{loc:Tr VaultSelection.Title}"
                 FontSize="32"
                 FontWeight="SemiBold" />

      <!-- TD-11: shown only after a lock brought the user back to this screen; see
           VaultSelectionViewModel.LockNotice. -->
      <Border Background="{DynamicResource PineSurfaceElevated}"
              BorderBrush="{DynamicResource PineWarning}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16,12"
              IsVisible="{Binding LockNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding LockNotice}"
                   Foreground="{DynamicResource PineText}"
                   TextWrapping="Wrap" />
      </Border>

      <!-- TD-35: the vault list failing to load used to be completely silent, which read as
           "you have no vaults". See VaultSelectionViewModel.VaultsUnavailable. -->
      <Border Background="{DynamicResource PineSurfaceElevated}"
              BorderBrush="{DynamicResource PineDanger}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16,12"
              IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource PineText}"
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <ListBox Grid.Row="1"
             ItemsSource="{Binding Vaults}" 
             Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="sec:VaultProfile">
          <Border BorderBrush="{DynamicResource PineBorder}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="20"
                  Margin="0,0,0,10"
                  Background="{DynamicResource PineSurface}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Medium"/>
                <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.5" Margin="0,5,0,0"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="{loc:Tr VaultSelection.OpenButton}"
                      Command="{Binding $parent[UserControl].((vm:VaultSelectionViewModel)DataContext).SelectVaultCommand}"
                      CommandParameter="{Binding}"
                      Classes="pine-accent"
                      Padding="20,10"
                      VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Button Grid.Row="2"
            Content="{loc:Tr VaultSelection.CreateNewVaultButton}"
            Command="{Binding CreateNewVaultCommand}" 
            HorizontalAlignment="Right" 
            Margin="0,20,0,0"
            Padding="20,10"/>
  </Grid>
</UserControl>
