<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             x:DataType="vm:VaultSelectionViewModel"
             x:Class="Pine.Ui.Avalonia.Views.VaultSelectionView">

  <Design.DataContext>
    <vm:VaultSelectionViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto" Margin="40">
    <TextBlock Text="Select a Vault" 
               FontSize="32" 
               FontWeight="SemiBold" 
               Margin="0,0,0,20"/>

    <ListBox Grid.Row="1" 
             ItemsSource="{Binding Vaults}" 
             Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#33FFFFFF" 
                  BorderThickness="1" 
                  CornerRadius="8" 
                  Padding="20" 
                  Margin="0,0,0,10"
                  Background="#11FFFFFF">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Medium"/>
                <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.5" Margin="0,5,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" 
                      Content="Open" 
                      Command="{Binding $parent[UserControl].((vm:VaultSelectionViewModel)DataContext).SelectVaultCommand}"
                      CommandParameter="{Binding}"
                      Classes="accent"
                      VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Button Grid.Row="2" 
            Content="Create New Vault" 
            Command="{Binding CreateNewVaultCommand}" 
            HorizontalAlignment="Right" 
            Margin="0,20,0,0"
            Padding="20,10"/>
  </Grid>
</UserControl>
