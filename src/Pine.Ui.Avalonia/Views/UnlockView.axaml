<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Pine.Ui.Avalonia.Views.UnlockView"
             x:DataType="vm:UnlockViewModel"
             Background="{DynamicResource PineBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentStack"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    MaxWidth="440"
                    Margin="20,24"
                    Spacing="28">

            <!-- Logo / Brand Header -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock x:Name="BrandTitle" Text="Pine" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource PineText}" />
                <TextBlock Text="{Binding VaultName}" FontSize="17" Foreground="{DynamicResource PineTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Unlock Card -->
            <Border x:Name="UnlockCard"
                    Background="{DynamicResource PineSurface}"
                    BorderBrush="{DynamicResource PineBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    BoxShadow="0 8 32 0 #30000000"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="20">

                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Unlock.Password.Label}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource PineTextMuted}" />
                        <!-- PasswordBox with masking -->
                        <TextBox PasswordChar="●"
                                 Text="{Binding MasterPassword}"
                                 IsEnabled="{Binding !IsBusy}"
                                 PlaceholderText="{loc:Tr Unlock.Password.Placeholder}"
                                 MinHeight="48"
                                 FontSize="16"
                                 Padding="14,12" />
                    </StackPanel>

                    <!-- Error/Status Message -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource PineDanger}"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <!-- Unlock Button -->
                    <Button Content="{loc:Tr Unlock.UnlockButton}"
                            Command="{Binding UnlockVaultCommand}"
                            Classes="pine-accent"
                            IsDefault="True"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            MinHeight="48"
                            Padding="16,12"
                            FontSize="16"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding !IsBusy}" />

                    <!-- Opt-in OS-credential unlock (TD-87). Only offered when this vault has a platform
                         wrap; it never replaces the password above. -->
                    <Button Content="{loc:Tr Unlock.PlatformButton}"
                            Command="{Binding UnlockWithPlatformCommand}"
                            IsVisible="{Binding CanUnlockWithPlatform}"
                            Classes="pine-outline"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            MinHeight="48"
                            Padding="16,12"
                            FontSize="15"
                            IsEnabled="{Binding !IsBusy}" />

                    <!-- Go Back Button -->
                    <Button Content="{loc:Tr Unlock.GoBackButton}"
                            Command="{Binding GoBackCommand}"
                            Background="Transparent"
                            Foreground="{DynamicResource PineTextMuted}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            MinHeight="44"
                            Padding="16,10"
                            FontSize="14"
                            IsEnabled="{Binding !IsBusy}" />

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
