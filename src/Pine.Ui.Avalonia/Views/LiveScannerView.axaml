<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Pine.Ui.Avalonia.Views.LiveScannerView"
             x:DataType="vm:LiveScannerViewModel">

  <Grid>
    <!-- Fallback background when no feed is active -->
    <Border Background="#1A1412" />

    <!-- Live Camera Feed -->
    <Image Source="{Binding LiveFeed}"
           Stretch="Uniform"
           IsVisible="{Binding LiveFeed, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- The camera picker that stood here listed "Camera 0" to "Camera 3" whatever was attached, and
         three of those four did not exist on a one-webcam machine (post-audit plan item 1.5). OpenCV
         cannot enumerate devices; the only way to know one exists is to open it, which would turn the
         camera on before the user pressed Start. The scanner uses the system default camera, and
         choosing between several waits for the camera seam TD-120 asks for. -->

    <!-- Scanner Reticle (decorative bracket corners + animated scan line) -->
    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="300" Height="400"
            IsVisible="{Binding IsScanning}">
      <Path Data="M 0,40 L 0,0 L 40,0"   Stroke="{DynamicResource PineSuccess}" StrokeThickness="3" />
      <Path Data="M 260,0 L 300,0 L 300,40" Stroke="{DynamicResource PineSuccess}" StrokeThickness="3" />
      <Path Data="M 0,360 L 0,400 L 40,400" Stroke="{DynamicResource PineSuccess}" StrokeThickness="3" />
      <Path Data="M 260,400 L 300,400 L 300,360" Stroke="{DynamicResource PineSuccess}" StrokeThickness="3" />

      <!-- Sweeping scan line -->
      <Rectangle Classes="scanline" Width="300" Height="2" Canvas.Left="0" Canvas.Top="0"
                 Fill="{DynamicResource PineSuccess}" RenderTransformOrigin="0,0">
        <Rectangle.Styles>
          <Style Selector="Rectangle.scanline">
            <Style.Animations>
              <Animation Duration="0:0:2.4" IterationCount="INFINITE" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                  <Setter Property="TranslateTransform.Y" Value="0" />
                  <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="12%">
                  <Setter Property="Opacity" Value="0.85" />
                </KeyFrame>
                <KeyFrame Cue="88%">
                  <Setter Property="Opacity" Value="0.85" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                  <Setter Property="TranslateTransform.Y" Value="398" />
                  <Setter Property="Opacity" Value="0" />
                </KeyFrame>
              </Animation>
            </Style.Animations>
          </Style>
        </Rectangle.Styles>
      </Rectangle>
    </Canvas>

    <!-- Bottom HUD Overlay -->
    <Border Background="#AA000000" VerticalAlignment="Bottom"
            HorizontalAlignment="Center" Margin="0,0,0,40"
            CornerRadius="14" Padding="28,14">
      <StackPanel Spacing="8" HorizontalAlignment="Center">
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="White" FontSize="17" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="{loc:Tr LiveScanner.StartCameraButton}"
                  Command="{Binding StartScanningCommand}"
                  IsVisible="{Binding !IsScanning}"
                  Classes="pine-accent" Padding="18,8" />
          <Button Content="{loc:Tr LiveScanner.CaptureNowButton}"
                  Command="{Binding CaptureManuallyCommand}"
                  IsVisible="{Binding IsScanning}"
                  Classes="pine-accent" Padding="18,8" />
          <Button Content="{loc:Tr LiveScanner.StopCameraButton}"
                  Command="{Binding StopScanningCommand}"
                  IsVisible="{Binding IsScanning}"
                  Classes="pine-danger" Padding="18,8" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
