<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Pine.Ui.Avalonia.Views.LiveScannerView"
             x:DataType="vm:LiveScannerViewModel">

  <Grid>
    <!-- Fallback background when no feed is active -->
    <Border Background="#1A1412" />

    <!-- Live Camera Feed -->
    <Image Source="{Binding LiveFeed}"
           Stretch="Uniform"
           IsVisible="{Binding LiveFeed, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <!-- Camera Selector Overlay -->
    <ComboBox ItemsSource="{Binding Cameras}"
              SelectedItem="{Binding SelectedCamera}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="16" Width="150"
              DisplayMemberBinding="{Binding Name}" />

    <!-- Scanner Reticle (decorative bracket corners) -->
    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="300" Height="400"
            IsVisible="{Binding IsScanning}">
      <Path Data="M 0,40 L 0,0 L 40,0"   Stroke="LightGreen" StrokeThickness="3" />
      <Path Data="M 260,0 L 300,0 L 300,40" Stroke="LightGreen" StrokeThickness="3" />
      <Path Data="M 0,360 L 0,400 L 40,400" Stroke="LightGreen" StrokeThickness="3" />
      <Path Data="M 260,400 L 300,400 L 300,360" Stroke="LightGreen" StrokeThickness="3" />
    </Canvas>

    <!-- Bottom HUD Overlay -->
    <Border Background="#AA000000" VerticalAlignment="Bottom"
            HorizontalAlignment="Center" Margin="0,0,0,40"
            CornerRadius="14" Padding="28,14">
      <StackPanel Spacing="8" HorizontalAlignment="Center">
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="White" FontSize="17" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Content="Start Camera"
                  Command="{Binding StartScanningCommand}"
                  IsVisible="{Binding !IsScanning}"
                  Classes="pine-accent" Padding="18,8" />
          <Button Content="Capture Now"
                  Command="{Binding CaptureManuallyCommand}"
                  IsVisible="{Binding IsScanning}"
                  Classes="pine-accent" Padding="18,8" />
          <Button Content="Stop Camera"
                  Command="{Binding StopScanningCommand}"
                  IsVisible="{Binding IsScanning}"
                  Classes="pine-danger" Padding="18,8" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
