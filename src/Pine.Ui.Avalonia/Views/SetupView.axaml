<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Pine.Ui.Avalonia.Views.SetupView"
             x:DataType="vm:SetupViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="40">
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="Pine" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="First-Run Setup" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Content -->
        <StackPanel Grid.Row="1" Spacing="20" VerticalAlignment="Center" MaxWidth="400">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            
            <TextBox PlaceholderText="Enter Master Password" 
                     Text="{Binding MasterPassword}" 
                     PasswordChar="●" 
                     IsEnabled="{Binding !IsBusy}"
                     Classes="revealPasswordButton"
                     FontSize="16" />
            
            <Button Content="Initialize Vault" 
                    Command="{Binding InitializeVaultCommand}" 
                    IsDefault="True"
                    IsEnabled="{Binding !IsBusy}"
                    Classes="pine-accent"
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    FontSize="16"
                    Padding="10"/>
                    
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
