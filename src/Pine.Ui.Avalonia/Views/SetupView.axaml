<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Pine.Ui.Avalonia.Views.SetupView"
             x:DataType="vm:SetupViewModel">

    <Grid ColumnDefinitions="4*,6*">
        <!-- Left Side: Branding Banner -->
        <Border Grid.Column="0" Background="{DynamicResource PineAccentGradient}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="40">
                
                <Image Source="avares://Pine.Ui.Avalonia/Assets/PineLogo.png" Width="120" Height="120" HorizontalAlignment="Center" />
                
                <TextBlock Text="Pine" FontSize="72" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Tr Setup.Banner.Tagline}" FontSize="20" Foreground="White" Opacity="0.85" FontWeight="Medium" HorizontalAlignment="Center" />

                <StackPanel Spacing="10" Margin="0,30,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Tr Setup.Banner.LocalFirst}" Foreground="White" Opacity="0.9" FontWeight="Medium" FontSize="16"/>
                    <TextBlock Text="{loc:Tr Setup.Banner.Encryption}" Foreground="White" Opacity="0.9" FontWeight="Medium" FontSize="16"/>
                    <TextBlock Text="{loc:Tr Setup.Banner.AiAssistance}" Foreground="White" Opacity="0.9" FontWeight="Medium" FontSize="16"/>
                </StackPanel>
                
            </StackPanel>
        </Border>

        <!-- Right Side: Interactive Setup -->
        <Border Grid.Column="1" Background="{DynamicResource PineBackground}" Padding="60,40">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Step 1: Storage Mode -->
                <StackPanel Spacing="25" VerticalAlignment="Center" MaxWidth="450" IsVisible="{Binding IsStep1}">
                    <TextBlock Text="{loc:Tr Setup.Storage.Title}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource PineText}" />
                    <TextBlock Text="{loc:Tr Setup.Storage.Description}" TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource PineTextMuted}" />

                    <Border Background="{DynamicResource PineSurface}" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource PinePrimary}" BorderThickness="2" BoxShadow="0 4 20 0 #10000000">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{loc:Tr Setup.Storage.LocalOnly.Label}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                            <TextBlock Text="{loc:Tr Setup.Storage.LocalOnly.Description}" Foreground="{DynamicResource PineTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="{loc:Tr Setup.Storage.ContinueButton}" Command="{Binding NextStepCommand}" Classes="pine-accent" HorizontalAlignment="Right" HorizontalContentAlignment="Center" FontSize="16" Padding="25,12" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- Step 2: Master Password -->
                <StackPanel Spacing="25" VerticalAlignment="Center" MaxWidth="450" IsVisible="{Binding IsStep2}">
                    <TextBlock Text="{loc:Tr Setup.Security.Title}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource PineText}" />
                    <TextBlock Text="{loc:Tr Setup.Security.Description}" TextWrapping="Wrap" FontSize="16" Foreground="{DynamicResource PineTextMuted}" />

                    <Border Background="{DynamicResource PineSurface}" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource PineBorder}" BorderThickness="1" BoxShadow="0 4 20 0 #10000000">
                        <StackPanel Spacing="15">
                            <TextBlock Text="{loc:Tr Setup.Security.VaultNameLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                            <TextBox PlaceholderText="{loc:Tr Setup.Security.VaultNamePlaceholder}"
                                     Text="{Binding VaultName}"
                                     IsEnabled="{Binding !IsBusy}"
                                     FontSize="16"
                                     Padding="15" />

                            <TextBlock Text="{loc:Tr Setup.Security.PasswordLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" Margin="0,10,0,0" />
                            <TextBox PlaceholderText="{loc:Tr Setup.Security.PasswordPlaceholder}"
                                     Text="{Binding MasterPassword}"
                                     PasswordChar="●"
                                     IsEnabled="{Binding !IsBusy}"
                                     FontSize="16"
                                     Padding="15" />

                            <!-- Strength meter (TD-11). Value/colour move as the user types; the
                                 pass/fail state is also carried in PasswordStrengthStatusText below,
                                 so nothing here relies on colour alone. -->
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding PasswordStrengthFraction}"
                                         Height="6" CornerRadius="3" Margin="0,4,0,0"
                                         Classes.pine-strength-danger="{Binding IsPasswordStrengthDanger}"
                                         Classes.pine-strength-warning="{Binding IsPasswordStrengthWarning}"
                                         Classes.pine-strength-success="{Binding IsPasswordStrengthSuccess}" />
                            <TextBlock Text="{Binding PasswordStrengthStatusText}"
                                       TextWrapping="Wrap" FontSize="13" FontWeight="Medium"
                                       IsVisible="{Binding PasswordStrengthStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Classes.pine-strength-danger="{Binding IsPasswordStrengthDanger}"
                                       Classes.pine-strength-warning="{Binding IsPasswordStrengthWarning}"
                                       Classes.pine-strength-success="{Binding IsPasswordStrengthSuccess}" />
                            <TextBlock Text="{Binding PasswordAdviceText}"
                                       TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PineTextMuted}"
                                       IsVisible="{Binding PasswordAdviceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock Text="{loc:Tr Setup.Security.ConfirmPasswordLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" Margin="0,10,0,0" />
                            <TextBox PlaceholderText="{loc:Tr Setup.Security.ConfirmPasswordPlaceholder}"
                                     Text="{Binding ConfirmPassword}"
                                     PasswordChar="●"
                                     IsEnabled="{Binding !IsBusy}"
                                     FontSize="16"
                                     Padding="15" />
                            <TextBlock Text="{loc:Tr Setup.Security.PasswordMismatch}"
                                       TextWrapping="Wrap" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource PineDanger}"
                                       IsVisible="{Binding !PasswordsMatch}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource PinePrimary}" FontWeight="Medium" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,10,0,0" Foreground="{DynamicResource PinePrimary}" />
                    
                    <Grid ColumnDefinitions="*,20,Auto" Margin="0,20,0,0">
                        <Button Grid.Column="0" Content="{loc:Tr Setup.Security.BackButton}" Command="{Binding BackStepCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Padding="15" Background="{DynamicResource PineSurfaceHover}" Foreground="{DynamicResource PineText}" BorderThickness="1" BorderBrush="{DynamicResource PineBorder}" CornerRadius="10"/>
                        <Button Grid.Column="2" Content="{loc:Tr Setup.Security.InitializeButton}" Command="{Binding InitializeVaultCommand}" IsDefault="True" IsEnabled="{Binding !IsBusy}" Classes="pine-accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Padding="25,15"/>
                    </Grid>
                </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
