<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Pine.Ui.Avalonia.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid ColumnDefinitions="250, *">
        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <StackPanel Spacing="10" Margin="20">
                <TextBlock Text="Pine Vault" FontSize="24" FontWeight="Bold" Margin="0,0,0,30" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                
                <Button Content="Dashboard" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,10" CornerRadius="8" />
                <Button Content="Transactions" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,10" CornerRadius="8" />
                <Button Content="Budgets" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,10" CornerRadius="8" />
                <Button Content="Rules" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,10" CornerRadius="8" />
                
                <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,10" />
                
                <Button Content="Settings" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15,10" CornerRadius="8" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *" Margin="40">
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,40">
                <TextBlock Text="{Binding Greeting}" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="Here's your financial overview for today." FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="Auto, *">
                
                <!-- Net Worth Card -->
                <Border Grid.Column="0" Grid.Row="0" Margin="0,0,20,0" Padding="30" CornerRadius="12" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        BoxShadow="0 4 10 0 #10000000">
                    <StackPanel>
                        <TextBlock Text="Total Balance" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalBalance}" FontSize="42" FontWeight="Bold" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Accounts List -->
                <Border Grid.Column="1" Grid.Row="0" Padding="20" CornerRadius="12" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        BoxShadow="0 4 10 0 #10000000">
                    <StackPanel>
                        <TextBlock Text="Your Accounts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" />
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SystemAccentColorLight2}">
                                                <TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Balance}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
