<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:views="using:Pine.Ui.Avalonia.Views"
             xmlns:views_imports="using:Pine.Ui.Avalonia.Views.Importing"
             xmlns:vm_importing="using:Pine.Ui.Avalonia.ViewModels.Importing"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:idd="using:Avalonia.Xaml.Interactions.DragAndDrop"
             xmlns:wvm="using:Pine.Ui.Avalonia.ViewModels.Widgets"
             xmlns:wv="using:Pine.Ui.Avalonia.Views.Widgets"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Pine.Ui.Avalonia.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             x:Name="DashboardRoot">

    <Grid>
        <!-- Main Content Area (Dashboard only) -->
        <Grid RowDefinitions="Auto, *" Margin="40">
            
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,40">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Greeting}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                    <TextBlock Text="{loc:Tr Dashboard.Header.Subtitle}" FontSize="14" Foreground="{DynamicResource PineTextMuted}" Margin="0,4,0,0" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- It had no Command at all: rendered, clickable, did nothing (post-audit plan item 1.4).
                         Hidden on a head without receipt vision, like the sidebar's receipt buttons (TD-85). -->
                    <Button Content="{loc:Tr Dashboard.Actions.ScanReceipt}" Command="{Binding OpenScanReceiptCommand}"
                            IsVisible="{Binding HasReceiptVision}"
                            Classes="pine-outline" Padding="15,10" CornerRadius="8" FontSize="14" />
                    <Button Content="{loc:Tr Dashboard.Actions.ImportData}" Command="{Binding ShowImportWizardCommand}" Classes="pine-outline" Padding="15,10" CornerRadius="8" FontSize="14" />
                    <Button Command="{Binding ShowCreateAccountDialogCommand}" Classes="pine-accent" Padding="15,10" CornerRadius="8" FontSize="14">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="+" />
                            <TextBlock Text="{loc:Tr Dashboard.Actions.NewAccount}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Widgets}" x:Name="WidgetsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Margin="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="10" Padding="0" CornerRadius="12"
                                    Background="{DynamicResource PineSurface}"
                                    BorderBrush="{DynamicResource PineBorder}"
                                    BorderThickness="1"
                                    BoxShadow="0 4 16 0 #18000000"
                                    Width="{Binding Width, Mode=TwoWay}"
                                    Height="{Binding Height, Mode=TwoWay}"
                                    MinWidth="240" MinHeight="180" MaxWidth="720"
                                    ClipToBounds="True"
                                    PointerPressed="Widget_PointerPressed"
                                    PointerMoved="Widget_PointerMoved"
                                    PointerReleased="Widget_PointerReleased"
                                    PointerCaptureLost="Widget_PointerCaptureLost">
                                <Grid RowDefinitions="Auto, *, Auto">
                                    
                                    <!-- Header / Drag Handle -->
                                    <Border Grid.Row="0" Padding="15,10" Cursor="Hand" ToolTip.Tip="{loc:Tr Dashboard.Widget.DragToReorder}"
                                            AutomationProperties.Name="{loc:Tr Dashboard.Widget.DragHandleAutomationName}">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                                    </Border>
                                    
                                    <!-- Content -->
                                    <ContentControl Grid.Row="1" Content="{Binding}" Margin="5,0,5,5">
                                        <ContentControl.DataTemplates>
                                            <DataTemplate DataType="wvm:BalanceWidgetViewModel">
                                                <wv:BalanceWidgetView />
                                            </DataTemplate>
                                            <DataTemplate DataType="wvm:RecentTransactionsWidgetViewModel">
                                                <wv:RecentTransactionsWidgetView />
                                            </DataTemplate>
                                            <DataTemplate DataType="wvm:TotalBalanceWidgetViewModel">
                                                <wv:TotalBalanceWidgetView />
                                            </DataTemplate>
                                            <DataTemplate DataType="wvm:CashFlowWidgetViewModel">
                                                <wv:CashFlowWidgetView />
                                            </DataTemplate>
                                            <DataTemplate DataType="wvm:BudgetWidgetViewModel">
                                                <wv:BudgetWidgetView />
                                            </DataTemplate>
                                            <!-- NO FALLBACK TEMPLATE, DELIBERATELY (post-audit plan item 1.3). There was one,
                                                 rendering "No data yet" for any tile without a view, which is how ten tiles
                                                 sat here saying nothing for thirty-nine iterations while looking finished.
                                                 DashboardTilesTests pins that every tile type has a live (uncommented)
                                                 template above. -->
                                        </ContentControl.DataTemplates>
                                    </ContentControl>

                                    <!-- Resize Handle -->
                                    <Thumb Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Width="15" Height="15" Cursor="BottomRightCorner"
                                           DragDelta="ResizeThumb_DragDelta"
                                           ToolTip.Tip="{loc:Tr Dashboard.Widget.DragToResize}"
                                           AutomationProperties.Name="{loc:Tr Dashboard.Widget.ResizeAutomationName}">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Path Data="M 10,10 L 15,10 L 15,15 Z" Fill="{DynamicResource PineTextMuted}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        
        <!-- Dialog Overlay -->
        <Border Background="{DynamicResource PineScrim}" IsVisible="{Binding IsCreateAccountDialogVisible}">
            <ContentControl Content="{Binding CreateAccountVm}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:CreateAccountViewModel}">
                        <views:CreateAccountView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

        <!-- Dialog Overlay (Import Wizard) -->
        <Border Background="{DynamicResource PineScrim}" IsVisible="{Binding IsImportWizardVisible}" ZIndex="90">
            <ContentControl Content="{Binding ImportWizardVm}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm_importing:ImportWizardViewModel}">
                        <views_imports:ImportWizardView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

        <!-- Drag Overlay -->
        <Canvas x:Name="DragOverlayCanvas" IsHitTestVisible="False" ZIndex="100" />
    </Grid>
</UserControl>
