<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:views="using:Pine.Ui.Avalonia.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Pine.Ui.Avalonia.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid>
        <!-- Main Content Area (Dashboard only) -->
        <Grid RowDefinitions="Auto, *" Margin="40">
            
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,40">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Greeting}" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="Here's your financial overview for today." FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
                
                <Button Grid.Column="1" Content="+ New Account" Command="{Binding ShowCreateAccountDialogCommand}" Classes="accent" VerticalAlignment="Center" Padding="15,10" CornerRadius="8" FontSize="14" />
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="Auto, *">
                
                <!-- Net Worth Card -->
                <Border Grid.Column="0" Grid.Row="0" Margin="0,0,20,0" Padding="30" CornerRadius="12" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        BoxShadow="0 4 10 0 #10000000">
                    <StackPanel>
                        <TextBlock Text="Total Balance" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalBalance}" FontSize="42" FontWeight="Bold" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Accounts List -->
                <Border Grid.Column="1" Grid.Row="0" Padding="20" CornerRadius="12" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        BoxShadow="0 4 10 0 #10000000">
                    <StackPanel>
                        <TextBlock Text="Your Accounts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" />
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource SystemAccentColorLight2}">
                                                <TextBlock Text="{Binding Name[0]}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Balance}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Dialog Overlay -->
        <Border Background="#80000000" IsVisible="{Binding IsCreateAccountDialogVisible}">
            <ContentControl Content="{Binding CreateAccountVm}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:CreateAccountViewModel}">
                        <views:CreateAccountView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
