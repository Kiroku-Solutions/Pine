<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Pine.Ui.Avalonia.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
        xmlns:views="using:Pine.Ui.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Pine.Ui.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://Pine.Ui.Avalonia/Assets/PineIcon.png"
        Title="{loc:Tr MainWindow.Title}"
        Width="900" Height="600"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PineBackground}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <views:MainView />

</Window>
