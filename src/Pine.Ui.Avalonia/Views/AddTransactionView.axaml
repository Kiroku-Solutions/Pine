<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="650"
             x:Class="Pine.Ui.Avalonia.Views.AddTransactionView"
             x:DataType="vm:AddTransactionViewModel">

    <ExperimentalAcrylicBorder CornerRadius="12"
                               MaxWidth="450" MaxHeight="700"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
        <ExperimentalAcrylicBorder.Material>
            <ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="Black" TintOpacity="1" MaterialOpacity="0.8" />
        </ExperimentalAcrylicBorder.Material>
        
        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="30" CornerRadius="12">
            <StackPanel Spacing="15">
                <TextBlock Text="New Transaction" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10" />
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />

            <!-- Type Toggle -->
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,0,0,10">
                <RadioButton Content="Expense" IsChecked="{Binding !IsIncome}" GroupName="TxType" />
                <RadioButton Content="Income" IsChecked="{Binding IsIncome}" GroupName="TxType" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Account" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="*, 10, *">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="Date" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
                
                <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Text="Amount" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <NumericUpDown Value="{Binding Amount}" FormatString="0.00" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}" Minimum="0" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="5">
                <TextBlock Text="Payee / Merchant" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{Binding Payee}" PlaceholderText="e.g. Walmart, Salary..." IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Category" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{Binding Category}" PlaceholderText="e.g. Groceries" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
            
            <StackPanel Spacing="5">
                <TextBlock Text="Notes" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{Binding Notes}" PlaceholderText="Optional notes..." IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Margin="0,10,0,0" />

            <Grid ColumnDefinitions="*, 10, *" Margin="0,20,0,0">
                <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
                <Button Grid.Column="2" Content="Save" Command="{Binding CreateCommand}" Classes="pine-accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsBusy}" />
            </Grid>
            </StackPanel>
        </Border>
    </ExperimentalAcrylicBorder>
</UserControl>
