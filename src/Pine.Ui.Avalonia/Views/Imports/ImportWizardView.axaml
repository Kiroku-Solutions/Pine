<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels.Importing"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Pine.Ui.Avalonia.Views.Importing.ImportWizardView"
             x:DataType="vm:ImportWizardViewModel">
    
    <Border Classes="card" Background="{DynamicResource PineSurface}" CornerRadius="12" Padding="24" BoxShadow="0 10 30 0 #40000000">
        <Grid RowDefinitions="Auto, *, Auto">
            <TextBlock Grid.Row="0" Text="Import Wizard" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" Margin="0,0,0,20"/>
            
            <StackPanel Grid.Row="1" Spacing="15" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding WizardStep}" FontSize="18" Foreground="{DynamicResource PineTextMuted}" HorizontalAlignment="Center" />
                <Button Content="Select File..." Click="SelectFile_Click" Classes="pine-accent" Padding="15,10" CornerRadius="8" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="pine-outline" Padding="15,8" CornerRadius="8" />
                <Button Content="Finish" Classes="pine-accent" Padding="15,8" CornerRadius="8" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
