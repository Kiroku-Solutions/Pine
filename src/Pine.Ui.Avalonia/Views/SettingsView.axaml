<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             xmlns:conv="using:Pine.Ui.Avalonia.Utils"
             xmlns:accounts="using:Pine.Core.Accounts"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Pine.Ui.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="24" Margin="40">
            <!-- Header -->
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Settings" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource PineText}" />
                <TextBlock Text="Manage your preferences and vault security." FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
            </StackPanel>

            <!-- Appearance Section -->
            <Border Background="{DynamicResource PineSurface}" 
                    BorderBrush="{DynamicResource PineBorder}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                    <Border Height="1" Background="{DynamicResource PineBorder}" />

                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel>
                            <TextBlock Text="Application Theme" FontSize="15" Foreground="{DynamicResource PineText}" />
                            <TextBlock Text="Choose how Pine looks on your device." FontSize="13" Foreground="{DynamicResource PineTextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="180" SelectedIndex="{Binding SelectedThemeIndex}" VerticalAlignment="Center">
                            <ComboBoxItem>Light</ComboBoxItem>
                            <ComboBoxItem>Dark</ComboBoxItem>
                            <ComboBoxItem>System Auto</ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource PineBorder}" />

                    <!-- Accent Palette Picker -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Accent Color" FontSize="15" Foreground="{DynamicResource PineText}" />
                            <TextBlock Text="Tint the entire app with your favourite hue." FontSize="13" Foreground="{DynamicResource PineTextMuted}" Margin="0,2,0,0" />
                        </StackPanel>

                        <ListBox Grid.Column="1"
                                 ItemsSource="{Binding Palettes}"
                                 SelectedIndex="{Binding SelectedPaletteIndex}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Accent color palette">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerTheme>
                                <ControlTheme TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border x:Name="ring" CornerRadius="20" Padding="3"
                                                    BorderThickness="2" BorderBrush="Transparent"
                                                    Background="Transparent">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                                                    </Transitions>
                                                </Border.Transitions>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                    <Style Selector="^:pointerover /template/ Border#ring">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PineTextMuted}" />
                                    </Style>
                                    <Style Selector="^:selected /template/ Border#ring">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PineText}" />
                                    </Style>
                                </ControlTheme>
                            </ListBox.ItemContainerTheme>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="conv:ThemePalette">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{Binding Brush}"
                                            ToolTip.Tip="{Binding Name}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Language Section -->
            <Border Background="{DynamicResource PineSurface}" 
                    BorderBrush="{DynamicResource PineBorder}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Language &amp; Locale" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                    <Border Height="1" Background="{DynamicResource PineBorder}" />

                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel>
                            <TextBlock Text="Display Language" FontSize="15" Foreground="{DynamicResource PineText}" />
                            <TextBlock Text="Select the language for the interface." FontSize="13" Foreground="{DynamicResource PineTextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="180" SelectedIndex="{Binding SelectedLanguageIndex}" VerticalAlignment="Center">
                            <ComboBoxItem>English</ComboBoxItem>
                            <ComboBoxItem>Spanish</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Security Section -->
            <Border Background="{DynamicResource PineSurface}" 
                    BorderBrush="{DynamicResource PineBorder}" 
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Security &amp; Vault" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                    <Border Height="1" Background="{DynamicResource PineBorder}" />
                    <TextBlock Text="Manage your vault's encryption and access controls." FontSize="13" Foreground="{DynamicResource PineTextMuted}" Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="Change Master Password" FontSize="15" Foreground="{DynamicResource PineText}" />
                            <TextBlock Text="Update your vault encryption key." FontSize="13" Foreground="{DynamicResource PineTextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Change Password" Command="{Binding ChangeMasterPasswordCommand}" Classes="pine-accent" Width="160" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="Export Vault" FontSize="15" Foreground="{DynamicResource PineText}" />
                            <TextBlock Text="Save a decrypted backup to disk." FontSize="13" Foreground="{DynamicResource PineTextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Export..." Command="{Binding ExportVaultCommand}" Width="160" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="Lock Vault Now" FontSize="15" Foreground="{DynamicResource PineText}" />
                            <TextBlock Text="Require the master password to continue." FontSize="13" Foreground="{DynamicResource PineTextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Lock Vault" Command="{Binding LockVaultCommand}" Classes="pine-danger" Width="160" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Data Integrity Section -->
            <Border x:Name="IntegritySection"
                    Background="{DynamicResource PineSurface}"
                    BorderBrush="{DynamicResource PineBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Data Integrity" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" />
                    <Border Height="1" Background="{DynamicResource PineBorder}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PineTextMuted}" Margin="0,0,0,4"
                               Text="Recompute an account's balance from its own transactions. Voided transactions are excluded. Nothing is changed unless the two disagree." />

                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="accounts:Account">
                                <Grid ColumnDefinitions="*, Auto" Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" Foreground="{DynamicResource PineText}" />
                                        <TextBlock Text="{Binding Balance}" FontSize="13" Foreground="{DynamicResource PineTextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Check Balance"
                                            Classes="pine-outline" Width="160"
                                            HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                            AutomationProperties.Name="Recompute this account's balance from its transactions"
                                            Command="{Binding #IntegritySection.((vm:SettingsViewModel)DataContext).RecalculateBalanceCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRecalculating}" Margin="0,4" />

                    <!-- The report is deliberately a sentence, not a checkmark: the user is being told
                         whether a number they have been trusting was right. -->
                    <Border IsVisible="{Binding RecalculationReport, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            CornerRadius="8" Padding="14,10"
                            Background="{DynamicResource PineSurfaceElevated}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource PineBorder}">
                        <TextBlock Text="{Binding RecalculationReport}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource PineText}" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
