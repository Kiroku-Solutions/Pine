<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pine.Ui.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Pine.Ui.Avalonia.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

    <Grid RowDefinitions="Auto, Auto, *" Margin="40">
        
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,32">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Diagnostics &amp; System" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource PineText}" />
                <TextBlock Text="Local runtime observability and diagnostic tools." FontSize="14" Foreground="{DynamicResource PineTextMuted}" />
            </StackPanel>

            <Button Grid.Column="1" Content="Export DIB" Command="{Binding ExportDibCommand}" Classes="pine-accent" VerticalAlignment="Center" Padding="16,10" CornerRadius="8" FontSize="14" ToolTip.Tip="Export Diagnostic Information Bundle" />
        </Grid>

        <!-- System Metrics Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,32">
            <!-- App Version -->
            <Border Background="{DynamicResource PineSurface}" BorderBrush="{DynamicResource PineBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,16,0" BoxShadow="0 4 16 0 #18000000">
                <StackPanel>
                    <TextBlock Text="App Version" FontSize="13" Foreground="{DynamicResource PineTextMuted}" FontWeight="Medium" />
                    <TextBlock Text="{Binding AppVersion}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- OS Version -->
            <Border Background="{DynamicResource PineSurface}" BorderBrush="{DynamicResource PineBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,16,0" BoxShadow="0 4 16 0 #18000000">
                <StackPanel>
                    <TextBlock Text="Host Environment" FontSize="13" Foreground="{DynamicResource PineTextMuted}" FontWeight="Medium" />
                    <TextBlock Text="{Binding OsVersion}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Database Status -->
            <Border Background="{DynamicResource PineSurface}" BorderBrush="{DynamicResource PineBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,16,0" BoxShadow="0 4 16 0 #18000000">
                <StackPanel>
                    <TextBlock Text="Vault DB Status" FontSize="13" Foreground="{DynamicResource PineTextMuted}" FontWeight="Medium" />
                    <TextBlock Text="{Binding DatabaseStatus}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PinePrimary}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Memory -->
            <Border Background="{DynamicResource PineSurface}" BorderBrush="{DynamicResource PineBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,0" BoxShadow="0 4 16 0 #18000000">
                <StackPanel>
                    <TextBlock Text="Engine Memory" FontSize="13" Foreground="{DynamicResource PineTextMuted}" FontWeight="Medium" />
                    <TextBlock Text="{Binding MemoryUsage}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PineText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Live Log Terminal -->
        <Border Grid.Row="2" Background="#0C0908" BorderBrush="{DynamicResource PineBorder}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" BoxShadow="0 8 32 0 #30000000">
            <Grid RowDefinitions="Auto, *">
                
                <!-- Terminal Header -->
                <Border Grid.Row="0" Background="#161110" BorderBrush="#2E241E" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource PineDanger}" />
                            <Ellipse Width="10" Height="10" Fill="#F5A623" />
                            <Ellipse Width="10" Height="10" Fill="#7ED321" />
                            <TextBlock Text="pine-engine-stdout.log" FontSize="12" Foreground="#827168" Margin="16,0,0,0" VerticalAlignment="Center" FontFamily="Consolas, Courier New, monospace" />
                        </StackPanel>

                        <Button Grid.Column="1" Content="Clear" Command="{Binding ClearLogsCommand}" Background="Transparent" Foreground="#827168" FontSize="12" Padding="8,4" CornerRadius="4" Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Log Output -->
                <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas, Courier New, monospace" FontSize="13" Foreground="#A3948B" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
