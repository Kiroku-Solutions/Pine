<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Pine.Ui.Avalonia.Controls">
  
  <Design.PreviewWith>
    <controls:ImageCropperControl Width="300" Height="400" />
  </Design.PreviewWith>

  <Style Selector="controls|ImageCropperControl">
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The adorner layer requires an AdornerDecorator higher up, 
             which is usually in the Window or visual root. We just need to expose the Image. -->
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <Image Name="PART_Image" 
                 Source="{TemplateBinding Source}" 
                 Stretch="Uniform" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
