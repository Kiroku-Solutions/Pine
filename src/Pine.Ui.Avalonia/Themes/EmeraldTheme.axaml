<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ══════════════════════════════════════════════════════════
         Pine accent palette · "Emerald" (green)
         ══════════════════════════════════════════════════════════ -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="PinePrimaryColor">#059669</Color>
            <Color x:Key="PinePrimaryContainerColor">#E3F7EF</Color>
            <SolidColorBrush x:Key="PinePrimary" Color="{StaticResource PinePrimaryColor}" />
            <SolidColorBrush x:Key="PinePrimaryContainer" Color="{StaticResource PinePrimaryContainerColor}" />
            <SolidColorBrush x:Key="PineAccentHover" Color="#D0F0E4" />
            <LinearGradientBrush x:Key="PineAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#059669" />
                <GradientStop Offset="1" Color="#10B981" />
            </LinearGradientBrush>

            <Color x:Key="SystemAccentColor">#059669</Color>
            <Color x:Key="SystemAccentColorLight1">#0AAE7A</Color>
            <Color x:Key="SystemAccentColorLight2">#12C68D</Color>
            <Color x:Key="SystemAccentColorLight3">#3AD6A5</Color>
            <Color x:Key="SystemAccentColorDark1">#048057</Color>
            <Color x:Key="SystemAccentColorDark2">#036A48</Color>
            <Color x:Key="SystemAccentColorDark3">#025339</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PinePrimaryColor">#34D399</Color>
            <Color x:Key="PinePrimaryContainerColor">#0C2E24</Color>
            <SolidColorBrush x:Key="PinePrimary" Color="{StaticResource PinePrimaryColor}" />
            <SolidColorBrush x:Key="PinePrimaryContainer" Color="{StaticResource PinePrimaryContainerColor}" />
            <SolidColorBrush x:Key="PineAccentHover" Color="#0F3A2C" />
            <LinearGradientBrush x:Key="PineAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#34D399" />
                <GradientStop Offset="1" Color="#059669" />
            </LinearGradientBrush>

            <Color x:Key="SystemAccentColor">#34D399</Color>
            <Color x:Key="SystemAccentColorLight1">#5CDDAD</Color>
            <Color x:Key="SystemAccentColorLight2">#84E7C2</Color>
            <Color x:Key="SystemAccentColorLight3">#ACF1D6</Color>
            <Color x:Key="SystemAccentColorDark1">#059669</Color>
            <Color x:Key="SystemAccentColorDark2">#048057</Color>
            <Color x:Key="SystemAccentColorDark3">#036A48</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
