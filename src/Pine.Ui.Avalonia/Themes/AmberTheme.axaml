<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ══════════════════════════════════════════════════════════
         Pine accent palette · "Amber" (default, warm orange)
         Owns every accent-family token. Neutrals live in App.axaml.
         ══════════════════════════════════════════════════════════ -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="PinePrimaryColor">#F57104</Color>
            <Color x:Key="PinePrimaryContainerColor">#FFF5EB</Color>
            <SolidColorBrush x:Key="PinePrimary" Color="{StaticResource PinePrimaryColor}" />
            <SolidColorBrush x:Key="PinePrimaryContainer" Color="{StaticResource PinePrimaryContainerColor}" />
            <SolidColorBrush x:Key="PineAccentHover" Color="#FDE4D0" />
            <LinearGradientBrush x:Key="PineAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#F57104" />
                <GradientStop Offset="1" Color="#D86E20" />
            </LinearGradientBrush>

            <Color x:Key="SystemAccentColor">#F57104</Color>
            <Color x:Key="SystemAccentColorLight1">#F78526</Color>
            <Color x:Key="SystemAccentColorLight2">#F99A4D</Color>
            <Color x:Key="SystemAccentColorLight3">#FBB074</Color>
            <Color x:Key="SystemAccentColorDark1">#D8630A</Color>
            <Color x:Key="SystemAccentColorDark2">#B85408</Color>
            <Color x:Key="SystemAccentColorDark3">#984506</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PinePrimaryColor">#F78526</Color>
            <Color x:Key="PinePrimaryContainerColor">#3D2010</Color>
            <SolidColorBrush x:Key="PinePrimary" Color="{StaticResource PinePrimaryColor}" />
            <SolidColorBrush x:Key="PinePrimaryContainer" Color="{StaticResource PinePrimaryContainerColor}" />
            <SolidColorBrush x:Key="PineAccentHover" Color="#3D2416" />
            <LinearGradientBrush x:Key="PineAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#F78526" />
                <GradientStop Offset="1" Color="#C64A02" />
            </LinearGradientBrush>

            <Color x:Key="SystemAccentColor">#F78526</Color>
            <Color x:Key="SystemAccentColorLight1">#F99A4D</Color>
            <Color x:Key="SystemAccentColorLight2">#FBB074</Color>
            <Color x:Key="SystemAccentColorLight3">#FCC69B</Color>
            <Color x:Key="SystemAccentColorDark1">#D8630A</Color>
            <Color x:Key="SystemAccentColorDark2">#B85408</Color>
            <Color x:Key="SystemAccentColorDark3">#984506</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
