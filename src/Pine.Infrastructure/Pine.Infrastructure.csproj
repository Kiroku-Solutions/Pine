    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!--
    MODEL ASSETS SHIPPED WITH THIS ASSEMBLY (TD-41).

    NAMED, NOT GLOBBED, AND THAT IS THE POINT. This used to read
    `Assets\Ai\*.onnx;Assets\Ai\*.txt`, and a glob is why nobody noticed that three of the four
    files it matched were dead: `PP-OCRv4-det.onnx` (113 MB), `PP-OCRv4-rec.onnx` (90 MB) and
    `dict.txt` were copied into every build output and every artefact, and no commit in the entire
    history of this repository, on any branch, ever named any of them. `git log -S "dict.txt"`
    and `git log -S "det.onnx"` each return zero commits.

    They were superseded before they were ever wired. `PaddleOcrEngine` runs
    `LocalFullModels.LatinV5`, whose weights are embedded resources inside
    `Sdcb.PaddleOCR.Models.LocalV5.dll` and are PP-OCR**v5**. The v4 pair on disk was a different
    model set for a code path that was never written.

    A glob makes adding 200 MB to the artefact a matter of dropping a file in a folder. Naming the
    file makes it a decision, in a diff, with a reviewer. `ShippedModelAssetsAreNamedByProductionCode`
    keeps the two lists equal.
  -->
  <ItemGroup>
    <Content Include="Assets\Ai\yolo-receipt-nano.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
