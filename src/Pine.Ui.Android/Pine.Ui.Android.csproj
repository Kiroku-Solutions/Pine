<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TD-129: no lock file; the workload this head needs is absent on a bare runner (NETSDK1147). -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <!--
      REAL APPLICATION IDENTITY, iteration 31 (TD-109, first half).

      This read `com.CompanyName.TempApp` with `android:label="TempApp"` beside it: the identity
      `dotnet new avalonia.app` writes, still here after every other head had been named. An
      application id is not cosmetic on Android: it is the package's primary key on the device
      and in the store, it cannot be changed after a first publish without shipping a different
      application, and `CompanyName.TempApp` is a name thousands of unrelated templates share.

      The reverse-DNS root is `org.pine`, matching the download host `29-Deployment` already
      names (`https://pine.org/dl/...`). ApplicationDisplayVersion tracks VersionPrefix in
      Directory.Build.props rather than restating `1.0`, which was a version this project has
      never had.
    -->
    <ApplicationId>org.pine.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Phones are arm64; x64 is the emulator. Dropping armeabi-v7a/x86 shrinks the APK and the build. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- A Debug APK must run when installed with plain `adb install` (no IDE fast-deployment session). -->
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!--
    ONNX OCR + YOLO + LayoutLMv3 MODELS AS APK ASSETS (docs/65 section 7). The files are linked here as named
    AndroidAsset entries (named, not globbed: the TD-41 rule). Stored UNCOMPRESSED so the first-run copy to the
    files directory (OcrModelInstaller) can compare sizes with AssetManager.OpenFd and skip the copy next time.
  -->
  <PropertyGroup>
    <AndroidStoreUncompressedFileExtensions>$(AndroidStoreUncompressedFileExtensions);.onnx;.json</AndroidStoreUncompressedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <AndroidAsset Include="..\Pine.Infrastructure\Assets\Ai\ocr\det.onnx" Link="Assets\ocr\det.onnx" />
    <AndroidAsset Include="..\Pine.Infrastructure\Assets\Ai\ocr\rec.onnx" Link="Assets\ocr\rec.onnx" />
    <AndroidAsset Include="..\Pine.Infrastructure\Assets\Ai\ocr\dict_latin_v5.txt" Link="Assets\ocr\dict_latin_v5.txt" />
    <!-- The receipt detector model, the same file Windows ships (docs/65 section 13): 13 MB, copied with the OCR models. -->
    <AndroidAsset Include="..\Pine.Infrastructure\Assets\Ai\yolo-receipt-nano.onnx" Link="Assets\yolo\yolo-receipt-nano.onnx" />
    <!-- LayoutLMv3 INT8 receipt field extractor (122 MB + 3.4 MB tokenizer) when the checkpoint is present locally. -->
    <AndroidAsset Include="..\..\research\checkpoints\layoutlmv3\model.onnx"
                  Link="Assets\layoutlm\model.onnx"
                  Condition="Exists('..\..\research\checkpoints\layoutlmv3\model.onnx')" />
    <AndroidAsset Include="..\..\research\checkpoints\layoutlmv3\tokenizer.json"
                  Link="Assets\layoutlm\tokenizer.json"
                  Condition="Exists('..\..\research\checkpoints\layoutlmv3\tokenizer.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pine.Ui.Avalonia\Pine.Ui.Avalonia.csproj" />
    <ProjectReference Include="..\Pine.Infrastructure\Pine.Infrastructure.csproj" />
    <ProjectReference Include="..\Pine.Application\Pine.Application.csproj" />
    <ProjectReference Include="..\Pine.Core\Pine.Core.csproj" />
  </ItemGroup>
</Project>
