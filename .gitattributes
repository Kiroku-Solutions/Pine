*.onnx filter=lfs diff=lfs merge=lfs -text
research/checkpoints/layoutlmv3/tokenizer.json filter=lfs diff=lfs merge=lfs -text

# Shell scripts must keep LF even on a Windows clone with core.autocrlf=true: CI runs them under
# bash, and BuildHygieneTests parses scripts/coverage-gate.sh -- with CRLF it read no floors at all,
# so a fresh clone failed a test that has nothing to do with the change being made (found by the
# independent review of post-audit plan item 1.5).
*.sh text eol=lf
